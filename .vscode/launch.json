{
  // The application is .NET: "coreclr" needs the C# extension (ms-dotnettools.csharp). Its native core,
  // tmdq_core.dll, is copied beside it by the build, so it is debugged from the native test executable instead,
  // with the debugger your editor has:
  //
  //   VS Code      has ms-vscode.cpptools  -> use the "MSVC debugger" entry.
  //   Antigravity  has vadimcn.vscode-lldb -> use the "CodeLLDB" entry (cpptools is
  //                Microsoft-licensed and not available in the fork).
  //
  // Both adapters read the MSVC PDBs. Debug the Debug builds; the Release builds carry no full debug info.
  //
  // A dev build keeps its preferences in %APPDATA%\tmDataQualityAnalyzer, which is your installed copy's: put a file
  // named "portable" beside the built exe to keep them beside it instead.
  //
  // To use the application, run "App (Release)": it runs on the Release core, as the shipped application does. "App
  // (Debug)" is for stepping through the C#. It runs on the Debug core, which is unoptimised and processes a recording
  // about three times slower (the full PRN recording's first stream: 14 s against 4.3 s).
  "version": "0.2.0",
  "configurations": [
    {
      "name": "App (Release)",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/src/TmDq.App/bin/Release/net10.0/tmDataQualityAnalyzer.exe",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "preLaunchTask": "Build app (Release)"
    },
    {
      "name": "App (Debug)",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/src/TmDq.App/bin/Debug/net10.0/tmDataQualityAnalyzer.exe",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "preLaunchTask": "Build app (Debug)"
    },
    {
      "name": "Native tests (Debug) - VS Code / MSVC debugger",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/out/Debug/tmdq_core_tests.exe",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "preLaunchTask": "Native tests"
    },
    {
      "name": "Native tests (Debug) - Antigravity / CodeLLDB",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/out/Debug/tmdq_core_tests.exe",
      "cwd": "${workspaceFolder}",
      "terminal": "integrated",
      "preLaunchTask": "Native tests"
    }
  ]
}
