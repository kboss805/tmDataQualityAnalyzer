{
  "configurations": [
    {
      "name": "windows-msvc-x64",
      "includePath": [
        "${workspaceFolder}/**",
        "${env:QTDIR}/include/**"
      ],
      "defines": [
        "UNICODE",
        "_UNICODE",
        "WIN32",
        "WIN64",
        "_ENABLE_EXTENDED_ALIGNED_STORAGE",
        "QT_PRINTSUPPORT_LIB",
        "QT_WIDGETS_LIB",
        "QT_SVG_LIB",
        "QT_GUI_LIB",
        "QT_CONCURRENT_LIB",
        "QT_CORE_LIB",
        "QT_NEEDS_QMAIN"
      ],
      "compilerPath": "cl.exe",
      "cStandard": "c11",
      "cppStandard": "c++17",
      "intelliSenseMode": "windows-msvc-x64"
    }
  ],
  "version": 4
}
