{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build core DLL (Debug)",
            "type": "shell",
            "command": "powershell.exe",
            "args": ["-ExecutionPolicy", "Bypass", "-File", "eng/build_core_dll.ps1", "-Configuration", "Debug"],
            "options": { "cwd": "${workspaceFolder}" },
            "group": "build",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Build core DLL (Release)",
            "type": "shell",
            "command": "powershell.exe",
            "args": ["-ExecutionPolicy", "Bypass", "-File", "eng/build_core_dll.ps1", "-Configuration", "Release"],
            "options": { "cwd": "${workspaceFolder}" },
            "group": "build",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Build app (Debug)",
            "detail": "The native core, then the Avalonia application, which copies tmdq_core.dll beside itself.",
            "type": "shell",
            "command": "powershell.exe",
            "args": ["-ExecutionPolicy", "Bypass", "-Command",
                     "powershell -ExecutionPolicy Bypass -File eng/build_core_dll.ps1 -Configuration Debug; if ($LASTEXITCODE) { exit $LASTEXITCODE }; $env:Platform = $null; dotnet build src/TmDq.App -c Debug -nologo"],
            "options": { "cwd": "${workspaceFolder}" },
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$msCompile"]
        },
        {
            "label": "Build app (Release)",
            "detail": "The native core and the Avalonia application in Release: the core runs about three times faster than its Debug build.",
            "type": "shell",
            "command": "powershell.exe",
            "args": ["-ExecutionPolicy", "Bypass", "-Command",
                     "powershell -ExecutionPolicy Bypass -File eng/build_core_dll.ps1 -Configuration Release; if ($LASTEXITCODE) { exit $LASTEXITCODE }; $env:Platform = $null; dotnet build src/TmDq.App -c Release -nologo"],
            "options": { "cwd": "${workspaceFolder}" },
            "group": "build",
            "problemMatcher": ["$msCompile"]
        },
        {
            "label": "Native tests",
            "type": "shell",
            "command": "powershell.exe",
            "args": ["-ExecutionPolicy", "Bypass", "-File", "eng/test_native.ps1", "-Configuration", "Debug"],
            "options": { "cwd": "${workspaceFolder}" },
            "group": "test",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Managed tests",
            "type": "shell",
            "command": "powershell.exe",
            "args": ["-ExecutionPolicy", "Bypass", "-File", "eng/test_dotnet.ps1", "-Configuration", "Debug"],
            "options": { "cwd": "${workspaceFolder}" },
            "group": "test",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "App tests",
            "type": "shell",
            "command": "powershell.exe",
            "args": ["-ExecutionPolicy", "Bypass", "-File", "eng/test_app.ps1", "-Configuration", "Debug"],
            "options": { "cwd": "${workspaceFolder}" },
            "group": "test",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Build manual (reuse figures)",
            "type": "shell",
            "command": "powershell.exe",
            "args": ["-ExecutionPolicy", "Bypass", "-File", "eng/build_manual.ps1", "-NoCapture"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        },
        {
            "label": "Gen compile_flags.txt (clangd)",
            "type": "shell",
            "command": "py",
            "args": ["eng/gen_compile_flags.py"],
            "options": { "cwd": "${workspaceFolder}" },
            "detail": "Generate compile_flags.txt for clangd/clang-tidy IntelliSense over the native core. Re-run after a fresh clone, in each worktree, or after an src/core/include/define change.",
            "problemMatcher": []
        }
    ]
}
