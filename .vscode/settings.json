{
  "editor.tabSize": 4,
  "editor.rulers": [
    120
  ],
  "editor.renderWhitespace": "trailing",
  "terminal.integrated.defaultProfile.windows": "PowerShell",
  "explorer.compactFolders": false,
  "explorer.copyRelativePathSeparator": "/",
  "files.autoSave": "onFocusChange",
  "files.associations": {
    ".clang*": "yaml"
  },
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "files.trimTrailingWhitespace": true,
  "workbench.editorAssociations": {
    "*.md": "vscode.markdown.preview.editor"
  },
  "git.enableSmartCommit": true,
  "git.autofetch": true,
  "git.confirmSync": false,
  "git.openRepositoryInParentFolders": "always",
  // Keep Claude Code worktrees (.claude/worktrees/*) from cluttering VSCode:
  // don't register each one as its own Source Control repository, and hide the
  // folder from the Explorer, search, and the file watcher. The main repo at the
  // workspace root is unaffected.
  "git.autoRepositoryDetection": false,
  "files.exclude": {
    "**/.claude/worktrees": true
  },
  "files.watcherExclude": {
    "**/.claude/worktrees/**": true
  },
  "search.exclude": {
    "**/.claude/worktrees": true
  },
  "markdown.validate.enabled": true,
  "[markdown]": {
    "files.trimTrailingWhitespace": false,
    "editor.formatOnSave": false,
    "editor.wordWrap": "wordWrapColumn",
    "editor.wordWrapColumn": 120
  },
  "[yaml]": {
    "editor.formatOnSave": false,
    "editor.wordWrap": "wordWrapColumn",
    "editor.wordWrapColumn": 120
  },
  "[plaintext]": {
    "editor.wordWrap": "wordWrapColumn",
    "editor.wordWrapColumn": 120
  },
  "[toml]": {
    "editor.wordWrap": "wordWrapColumn",
    "editor.wordWrapColumn": 120
  },
  // clangd is the C++ IntelliSense (it reads the generated compile_flags.txt: eng/gen_compile_flags.py); cpptools is
  // installed for its Windows debugger (launch.json "cppvsdbg") and must not run a second engine beside it.
  // The repository has no .clang-format, so "none" leaves a file's formatting alone instead of reflowing it as LLVM.
  "clangd.arguments": [
    "--completion-style=detailed",
    "--header-insertion=never",
    "--clang-tidy",
    "--fallback-style=none"
  ],
  "C_Cpp.intelliSenseEngine": "disabled",
  "[c]": {
    "editor.formatOnSave": false,
    "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
  },
  "[cpp]": {
    "editor.formatOnSave": false,
    "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
  },
  "dotnet.defaultSolution": "tmdq.sln"
}
