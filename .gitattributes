# Auto-detect text files and normalize line endings
* text=auto

# Force LF for shell scripts
*.sh text eol=lf

# Force CRLF for Windows-specific files
*.bat text eol=crlf
*.cmd text eol=crlf
*.rc text eol=crlf

# Binary files
*.ico binary
*.png binary
*.exe binary
*.dll binary

# Qt-written templates, compared byte for byte (CR LF included): stored exactly as written
tests/TmDq.App.Tests/Templates/*.json -text

# The Qt application's preferences as QSettings wrote them, read by the importer: stored exactly as written
tests/TmDq.App.Tests/QtSettings/*.ini -text
