# tmDataQualityAnalyzer — static analysis configuration.
#
# This codebase already uses inline NOLINT suppressions for the deliberate,
# reviewed cases where it wraps the third-party irig106 C library (raw pointer
# arithmetic over PCM byte buffers, reinterpret_cast of payloads, malloc/free and
# owning-memory across the C boundary, and the one high-complexity hot-path state
# machine in FrameProcessor::process). Those checks are intentionally ENABLED here
# so the suppressions stay meaningful and any NEW unjustified violation is flagged.
#
# Noisy checks that fight this project's Qt + C-interop reality (header-guard
# style, magic-number literals in bit math, trailing return types, identifier
# length, etc.) are disabled to keep signal high.
#
# How to run (generate the compile DB first, then run from the repo root — both
# clang-tidy and clangd auto-discover compile_flags.txt by walking up the tree):
#   py scripts/gen_compile_flags.py      # writes compile_flags.txt at the repo root
#   clang-tidy src/model/frameprocessor.cpp
# Analysis only — WarningsAsErrors is empty so it never breaks the build. Never
# run --fix on lib/irig106/ or lib/qcustomplot/ (protected third-party code).

Checks: >
  bugprone-*,
  cppcoreguidelines-*,
  performance-*,
  portability-*,
  misc-*,
  readability-*,
  modernize-*,
  -modernize-use-trailing-return-type,
  -modernize-avoid-c-arrays,
  -modernize-use-nodiscard,
  -cppcoreguidelines-avoid-magic-numbers,
  -readability-magic-numbers,
  -readability-identifier-length,
  -readability-identifier-naming,
  -readability-function-cognitive-complexity,
  -readability-braces-around-statements,
  -readability-implicit-bool-conversion,
  -misc-non-private-member-variables-in-classes,
  -cppcoreguidelines-non-private-member-variables-in-classes,
  -cppcoreguidelines-avoid-non-const-global-variables,
  -bugprone-easily-swappable-parameters,
  -modernize-use-default-member-init

# Only analyze THIS project's own headers. The regex is anchored on the project
# folder name on purpose: a bare "(include|src)" also matches Qt's own
# .../msvc2022_64/include/QtCore/... path and floods the report with thousands of
# warnings from third-party headers. Keep it anchored to tmDataQualityAnalyzer/.
HeaderFilterRegex: 'tmDataQualityAnalyzer[/\\](include|src)[/\\].*\.h$'

WarningsAsErrors: ''
