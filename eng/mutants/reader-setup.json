      "file": "src/core/src/chapter10reader.cpp",
      "old": "    failure = ch10setup::readTmats(setup_lock, m_file_handle, m_header, m_buffer, m_tmats_info, m_status);\n    if (failure != ch10setup::Failure::None)\n    {\n        m_last_error = ch10setup::describe(failure);\n        closeFile();\n        return false;\n    }\n",
