    { "id": "A6", "file": "src/TmDq.App/Views/Plot/PlotChart.cs",
      "old": "RenderData(into, size, draft ? 1.0 / scale : 0.0);", "new": "RenderData(into, size, draft ? 1.0 : 0.0);",
      "expect": "caught", "note": "a draft's lines one unit wide rather than one device pixel: seen only above scaling 1, as A5" },
    { "id": "A7", "file": "src/TmDq.App/Views/Plot/PlotChart.cs",
