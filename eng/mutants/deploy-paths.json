{
  "suite": "managed",
  "args": [
    "-class",
    "TmDq.Core.Tests.RepoFilesTests"
  ],
  "mutants": [
    {
      "id": "D1",
      "file": "deploy/tmDataQualityAnalyzer.iss",
      "old": "InfoBeforeFile=RELEASENOTES.txt",
      "new": "InfoBeforeFile=..\\RELEASENOTES.txt",
      "expect": "caught",
      "note": "the release notes' path as it was before the script moved up a level"
    },
    {
      "id": "D2",
      "file": "deploy/tmDataQualityAnalyzer.iss",
      "old": "LicenseFile=..\\LICENSE",
      "new": "LicenseFile=..\\..\\LICENSE",
      "expect": "caught",
      "note": "the licence path as it was before the move"
    },
    {
      "id": "D3",
      "file": "deploy/tmDataQualityAnalyzer.iss",
      "old": "SetupIconFile=..\\assets\\icon.ico",
      "new": "SetupIconFile=..\\assets\\icon.icx",
      "expect": "caught",
      "note": "an icon that is not there"
    },
    {
      "id": "D4",
      "file": "deploy/build_package.ps1",
      "old": "$Root = (Resolve-Path (Join-Path $Here '..')).Path",
      "new": "$Root = (Resolve-Path (Join-Path $Here '\\..\\..')).Path",
      "expect": "caught",
      "note": "the package script's root one level too high"
    }
  ]
}
