{
  "suite": "managed",
  "args": [
    "-class",
    "TmDq.Core.Tests.RepoFilesTests"
  ],
  "mutants": [
    {
      "id": "D1",
      "file": "deploy/tmDataQualityAnalyzer.wxs",
      "old": "$(RepoRoot)\\deploy\\RELEASENOTES.txt",
      "new": "$(RepoRoot)\\RELEASENOTES.txt",
      "expect": "caught",
      "note": "the release notes' path as it was before the script moved up a level"
    },
    {
      "id": "D2",
      "file": "deploy/tmDataQualityAnalyzer.wxs",
      "old": "$(RepoRoot)\\assets\\icon.ico",
      "new": "$(RepoRoot)\\assets\\icon.icx",
      "expect": "caught",
      "note": "an icon that is not there"
    },
    {
      "id": "D3",
      "file": "deploy/build_msi.ps1",
      "old": "$Root = (Resolve-Path (Join-Path $Here '..')).Path",
      "new": "$Root = (Resolve-Path (Join-Path $Here '\\..\\..')).Path",
      "expect": "caught",
      "note": "the MSI script's root one level too high"
    },
    {
      "id": "D4",
      "file": "deploy/build_package.ps1",
      "old": "$Root = (Resolve-Path (Join-Path $Here '..')).Path",
      "new": "$Root = (Resolve-Path (Join-Path $Here '\\..\\..')).Path",
      "expect": "caught",
      "note": "the package script's root one level too high"
    },
    {
      "id": "D5",
      "file": "deploy/build_msi.ps1",
      "old": "-d \"StagingManual=$ManualDir\"",
      "new": "-d \"StagingManuals=$ManualDir\"",
      "expect": "caught",
      "note": "a variable the MSI source uses that the script no longer defines (an error only when the package is built)"
    },
    {
      "id": "D6",
      "file": "deploy/tmDataQualityAnalyzer.wxs",
      "old": "<RegistryValue Root=\"HKMU\" Key=\"Software\\Classes\\.ch10\\OpenWithProgids\" Name=\"tmDataQualityAnalyzer.ch10\" Type=\"string\" Value=\"\" />",
      "new": "<RegistryValue Root=\"HKMU\" Key=\"Software\\Classes\\.ch10\" Type=\"string\" Value=\"tmDataQualityAnalyzer.ch10\" />",
      "expect": "caught",
      "note": "the MSI taking .ch10's default itself (an uninstall then deletes an association another application took)"
    },
    {
      "id": "D7",
      "file": "deploy/tmDataQualityAnalyzer.wxs",
      "old": "<RegistryValue Root=\"HKMU\" Key=\"Software\\tmDataQualityAnalyzer\" Name=\"StartMenuShortcuts\"",
      "new": "<RegistryValue Root=\"HKLM\" Key=\"Software\\tmDataQualityAnalyzer\" Name=\"StartMenuShortcuts\"",
      "expect": "caught",
      "note": "a registry write to HKLM (a per-user install by a user without admin rights would fail on it)"
    },
    {
      "id": "D8",
      "file": "deploy/build_msi.ps1",
      "old": "DELETE FROM `Property` WHERE `Property`=''MSIINSTALLPERUSER''",
      "new": "SELECT `Value` FROM `Property` WHERE `Property`=''MSIINSTALLPERUSER''",
      "expect": "caught",
      "note": "MSIINSTALLPERUSER left in the package (a silent install from an elevated deployment tool would be per-user, into SYSTEM's profile)"
    },
    {
      "id": "D9",
      "file": "deploy/tmDataQualityAnalyzer.wxs",
      "old": "Value=\"[ProgramFiles64Folder][ApplicationFolderName]\"",
      "new": "Value=\"[ProgramFilesFolder][ApplicationFolderName]\"",
      "expect": "caught",
      "note": "the per-machine folder the dialog set builds, in the 32-bit Program Files"
    },
    {
      "id": "D10",
      "file": "deploy/tmDataQualityAnalyzer.wxs",
      "old": "Value=\"[APPLICATIONFOLDER]\\tmDataQualityAnalyzer.exe\"",
      "new": "Value=\"[#AppExe]\"",
      "expect": "caught",
      "note": "the Finish page's launch reads the exe's File row, which the wizard resolved before the scope choice (a per-user install's launch looks in Program Files)"
    },
    {
      "id": "D11",
      "file": "deploy/tmDataQualityAnalyzer.wxs",
      "old": "Condition=\"WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed\" Order=\"2\"",
      "new": "Condition=\"WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed\" Order=\"0\"",
      "expect": "caught",
      "note": "the launch runs before the path is set"
    },
    {
      "id": "D12",
      "file": "deploy/tmDataQualityAnalyzer.wxs",
      "old": "    <WixVariable Id=\"WixUIBannerBmp\" Value=\"$(RepoRoot)\\assets\\installer_banner.bmp\" />\n",
      "new": "",
      "expect": "caught",
      "note": "the wizard's banner is WiX's stock one again"
    }
  ]
}
