      "note": "every channel shows, as before"
    },
    {
      "id": "V3",
      "file": "src/TmDq.App/ViewModels/Plot/PlotViewModel.cs",
      "old": "ShowOnlyTheCombinedChannels(added);",
      "new": "_ = added;",
