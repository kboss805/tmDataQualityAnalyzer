      "old": "if (!group.Any(s => s.ChannelIndex == PlotColors.CombinedChannelIndex)) continue;",
      "new": "if (!group.Any(s => s.ChannelIndex == PlotColors.CombinedChannelIndex) && false) continue;",
      "expect": "caught",
      "note": "a receiver with no combined channel has all of its series hidden"
    },
    {
      "id": "V2",
      "file": "src/TmDq.App/ViewModels/Plot/PlotViewModel.cs",
      "old": "foreach (PlotSeries s in group) s.Visible = s.ChannelIndex == PlotColors.CombinedChannelIndex;",
      "new": "foreach (PlotSeries s in group) s.Visible = true;",
