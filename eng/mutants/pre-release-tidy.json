{
  "suite": "app",
  "args": [
    "-class",
    "TmDq.App.Tests.RemoveFileTests",
    "-class",
    "TmDq.App.Tests.AddRecordingTests",
    "-class",
    "TmDq.App.Tests.CalibrationChannelTests",
    "-stopOnFail"
  ],
  "mutants": [
    {
      "id": "P1",
      "file": "src/TmDq.App/ViewModels/MainWindowViewModel.cs",
      "old": "        _lastRunFile = Path.GetFileName(request.FileName);\n",
      "new": "",
      "expect": "caught",
      "note": "an added recording's non-overlap warning names no file"
    },
    {
      "id": "P2",
      "file": "src/TmDq.App/ViewModels/MainWindowViewModel.cs",
      "old": "_sources.RemoveAll(s => s.SourceId == id) > 0",
      "new": "_sources.RemoveAll(s => s.SourceId != id) > 0",
      "expect": "caught",
      "note": "Remove File takes out every recording but the one removed from what Save Template captures"
    },
    {
      "id": "P3",
      "file": "src/TmDq.App/ViewModels/Plot/PlotViewModel.cs",
      "old": "        foreach (int id in removing) SourceRemoved?.Invoke(this, id);",
      "new": "        foreach (int id in removing.Skip(1)) SourceRemoved?.Invoke(this, id);",
      "expect": "caught",
      "note": "the first recording removed is not told, and Save Template keeps it"
    },
    {
      "id": "P4",
      "file": "src/TmDq.App/ViewModels/Plot/PlotViewModel.cs",
      "old": "if (removedLabels.Contains(Title)) Title = SourceList()[0].Label;",
      "new": "if (!removedLabels.Contains(Title)) Title = SourceList()[0].Label;",
      "expect": "caught",
      "note": "a title the operator wrote is replaced, and one that named the removed recording stays"
    },
    {
      "id": "P5",
      "file": "src/TmDq.App/ViewModels/Plot/PlotViewModel.cs",
      "old": "Title = SourceList()[0].Label;",
      "new": "Title = SourceList()[^1].Label;",
      "expect": "caught",
      "note": "the title names the last recording left, not the first"
    },
    {
      "id": "P6",
      "file": "src/TmDq.App/ViewModels/Plot/PlotCommands.cs",
      "old": "int selected = sources.Count == 1 ? 0 : sources.ToList().FindIndex(s => s.Id == _plot.VisibleSource);",
      "new": "int selected = sources.Count == 1 ? -1 : sources.ToList().FindIndex(s => s.Id == _plot.VisibleSource);",
      "expect": "caught",
      "note": "the only recording starts unchosen"
    },
    {
      "id": "P7",
      "file": "src/TmDq.App/ViewModels/Plot/PlotCommands.cs",
      "old": "sources.ToList().FindIndex(s => s.Id == _plot.VisibleSource);",
      "new": "sources.ToList().FindIndex(s => true);",
      "expect": "caught",
      "note": "with several overlaid, the first starts chosen and Enter removes it"
    },
    {
      "id": "P8",
      "file": "src/TmDq.App/Views/Dialogs/ChoiceWindow.cs",
      "old": "        OkButton.IsEnabled = Choices.SelectedIndex >= 0;\n        Choices.SelectionChanged",
      "new": "        Choices.SelectionChanged",
      "expect": "caught",
      "note": "OK is available with nothing chosen"
    },
    {
      "id": "P9",
      "file": "src/TmDq.App/Views/Dialogs/ChoiceWindow.cs",
      "old": "Choices.SelectionChanged += (_, _) => OkButton.IsEnabled = Choices.SelectedIndex >= 0;",
      "new": "Choices.SelectionChanged += (_, _) => OkButton.IsEnabled = false;",
      "expect": "caught",
      "note": "OK stays held after something is chosen"
    },
    {
      "id": "P10",
      "file": "src/TmDq.App/ViewModels/Dialogs/ExtractCalibrationViewModel.cs",
      "old": "        if (timeLacking)",
      "new": "        if (!timeLacking)",
      "expect": "caught",
      "note": "a time channel the recording lacks is not said, and one it has is"
    },
    {
      "id": "P11",
      "file": "src/TmDq.App/ViewModels/Dialogs/ExtractCalibrationViewModel.cs",
      "old": "bool timeLacking = time < 0 && _calTime.Count > 0;",
      "new": "bool timeLacking = false;",
      "expect": "caught",
      "note": "the note never mentions the time channel"
    },
    {
      "id": "P12",
      "file": "src/TmDq.App/ViewModels/Dialogs/ExtractCalibrationViewModel.cs",
      "old": "        if (version != _loadVersion) return;   // another recording was chosen while",
      "new": "        if (version == _loadVersion + 1000) return;   // another recording was chosen while",
      "expect": "caught",
      "note": "an earlier recording's channels that arrive late replace the later one's"
    },
    {
      "id": "P13",
      "file": "src/TmDq.App/ViewModels/Dialogs/ExtractCalibrationViewModel.cs",
      "old": "        int version = ++_loadVersion;",
      "new": "        int version = _loadVersion++;",
      "expect": "caught",
      "note": "the version taken is one behind the counter, so every choice looks stale and none is ever listed"
    }
  ]
}
