{
  "suite": "app",
  "args": [
    "-class",
    "TmDq.App.Tests.RemoveFileTests",
    "-class",
    "TmDq.App.Tests.ChartViewTests",
    "-stopOnFail"
  ],
  "mutants": [
    {
      "id": "R1",
      "file": "src/TmDq.App/ViewModels/Plot/PlotViewModel.cs",
      "old": "        _series.RemoveAll(s => s.SourceId == sourceId);\n        _sourceLabels.Remove(sourceId);",
      "new": "        _series.RemoveAll(s => s.SourceId != sourceId);\n        _sourceLabels.Remove(sourceId);",
      "expect": "caught",
      "note": "keeps the recording asked to go and drops the others"
    },
    {
      "id": "R2",
      "file": "src/TmDq.App/ViewModels/Plot/PlotViewModel.cs",
      "old": "        _series.RemoveAll(s => s.SourceId == sourceId);\n        _sourceLabels.Remove(sourceId);",
      "new": "        _series.RemoveAll(s => s.SourceId == sourceId);\n        _ = _sourceLabels.Count;",
      "expect": "caught",
      "note": "the recording's name stays, and a later recording by the same id carries it"
    },
    {
      "id": "R3",
      "file": "src/TmDq.App/ViewModels/Plot/PlotViewModel.cs",
      "old": "if (_readoutSeriesId is int pin && _series.All(s => s.Id != pin)) _readoutSeriesId = null;",
      "new": "if (_readoutSeriesId is int pin && _series.All(s => s.Id == pin)) _readoutSeriesId = null;",
      "expect": "caught",
      "note": "a readout pinned to a removed series stays pinned, and one pinned to a kept series is dropped"
    },
    {
      "id": "R4",
      "file": "src/TmDq.App/ViewModels/Plot/PlotViewModel.cs",
      "old": "bool drawnChanged = _visibleSource < 0 || _visibleSource == sourceId;",
      "new": "bool drawnChanged = true;",
      "expect": "caught",
      "note": "removing a recording that is not shown refits the view the operator zoomed"
    },
    {
      "id": "R5",
      "file": "src/TmDq.App/ViewModels/Plot/PlotViewModel.cs",
      "old": "        if (_visibleSource == sourceId) _visibleSource = -1;\n",
      "new": "",
      "expect": "caught",
      "note": "the recording shown alone is removed and the plot still names it as the one shown"
    },
    {
      "id": "R6",
      "file": "src/TmDq.App/ViewModels/Plot/PlotViewModel.cs",
      "old": "        if (!_series.Any(s => s.SourceId == sourceId)) return false;",
      "new": "        if (!_series.Any(s => s.SourceId == sourceId)) return true;",
      "expect": "caught",
      "note": "a recording that is not there is said to have been removed"
    },
    {
      "id": "R7",
      "file": "src/TmDq.App/ViewModels/Plot/PlotViewModel.cs",
      "old": "            SetVisibleSource(_visibleSource);   // the window and the axes follow what is left; it tells the view",
      "new": "            SeriesChanged?.Invoke(this, EventArgs.Empty);",
      "expect": "caught",
      "note": "the window and the axes keep the removed recording's span"
    },
    {
      "id": "R8",
      "file": "src/TmDq.App/ViewModels/Plot/PlotViewModel.cs",
      "old": "        if (_series.All(s => s.SourceId == sourceId))\n        {\n            Clear();",
      "new": "        if (_series.Count == 99)\n        {\n            Clear();",
      "expect": "caught",
      "note": "the only recording's removal does not leave the plot as a new one"
    },
    {
      "id": "R9",
      "file": "src/TmDq.App/ViewModels/Plot/PlotCommands.cs",
      "old": "_plot.RemoveSource(sources[index].Id);",
      "new": "_plot.RemoveSource(sources[0].Id);",
      "expect": "caught",
      "note": "the first recording goes whichever was chosen"
    },
    {
      "id": "R10",
      "file": "src/TmDq.App/ViewModels/Plot/PlotCommands.cs",
      "old": "        string label = sources.Count == 1\n",
      "new": "        string label = sources.Count == 2\n",
      "expect": "caught",
      "note": "one recording is asked about as if others were kept"
    },
    {
      "id": "R11",
      "file": "src/TmDq.App/ViewModels/Plot/PlotCommands.cs",
      "old": "        if (sources.Count == 0) return;\n        string label = sources.Count == 1",
      "new": "        string label = sources.Count == 1",
      "expect": "caught",
      "note": "Remove File asks, with nothing in the plot, which recording to remove"
    },
    {
      "id": "R12",
      "file": "src/TmDq.App/Views/Plot/PlotView.axaml",
      "old": "<MenuItem Header=\"Remove File...\" Command=\"{Binding RemoveFileCommand}\" />",
      "new": "<MenuItem Header=\"Remove File...\" Command=\"{Binding SetTitleCommand}\" />",
      "expect": "caught",
      "note": "the menu item sets the plot's title"
    }
  ]
