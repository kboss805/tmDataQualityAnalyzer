      "file": "src/TmDq.App/CrashHandling.cs",
      "old": "if (!_reporter.TryWrite(source, error, out string? path)) return;",
      "new": "_reporter.TryWrite(source, error, out string? path);",
      "expect": "survived",
      "note": "equivalent: a duplicate means an earlier Raised already told the user, and the once-per-process guard on the next line returns anyway. The early return says why, and is the first thing a reader looks for"
    },
