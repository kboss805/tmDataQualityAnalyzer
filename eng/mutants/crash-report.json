    {
      "id": "H1",
      "file": "src/TmDq.App/CrashHandling.cs",
      "old": "if (_tell is null || Interlocked.Exchange(ref _told, 1) != 0) return;",
      "new": "if (_tell is null || Interlocked.Exchange(ref _told, 0) != 0) return;",
      "expect": "caught",
      "note": "the once-per-process flag is never set, so a second exception on the way out opens a second message box"
    },
    {
