<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests of the Avalonia application on Avalonia's headless platform: no window system, no GPU, no desktop
    session, so they run the same on a developer machine and on the CI runner. Drawing goes
    through Skia, so a test can measure real layout and read real pixels.

    An xunit v3 test project is an executable: run bin\<Configuration>\net10.0\TmDq.App.Tests.exe directly
    (eng\test_app.ps1 builds and runs it).
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>TmDq.App.Tests</AssemblyName>
    <RootNamespace>TmDq.App.Tests</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <AppendPlatformToOutputPath>false</AppendPlatformToOutputPath>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless.XUnit" />
    <PackageReference Include="Avalonia.Skia" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TmDq.App\TmDq.App.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The library tests' retrying delete, for the temporary files these tests write too. -->
    <Compile Include="..\TmDq.Core.Tests\Support\TempFiles.cs" Link="Support\TempFiles.cs" />
    <!-- and the one place that finds the repository root and its committed recordings. -->
    <Compile Include="..\TmDq.Core.Tests\Support\RepoPaths.cs" Link="Support\RepoPaths.cs" />
  </ItemGroup>

  <!-- The test exe selects the UTF-8 active code page, as the application and the other test hosts do (the shared
       assets\utf8codepage.manifest, merged with mt.exe, which eng\WindowsSdkTools.targets finds): a test that hands the
       core a non-ASCII path can then run here, and a test asserts the code page. -->
  <Target Name="EmbedUtf8Manifest" AfterTargets="Build" DependsOnTargets="TmDqFindMt">
    <Exec Command="&quot;$(TmDqMt)&quot; -nologo -manifest &quot;$(MSBuildThisFileDirectory)..\..\assets\utf8codepage.manifest&quot; -outputresource:&quot;$(OutDir)$(AssemblyName).exe;#1&quot;"
          ContinueOnError="false" />
  </Target>

</Project>
