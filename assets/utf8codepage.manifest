<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- The UTF-8 active code page, for the three test hosts: merged into the native test executable by tests\core\tmdq_core_tests.vcxproj and, with mt.exe, into the two .NET ones (tests\TmDq.Core.Tests, tests\TmDq.App.Tests). The application has its own, src\TmDq.App\app.manifest, which also declares Windows 10. -->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
