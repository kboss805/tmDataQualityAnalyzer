    <ClInclude Include="include\ch10packetreader.h" />
    <ClInclude Include="include\channeldata.h" />
    <ClInclude Include="include\ch10setup.h" />
    <ClInclude Include="include\chapter10reader.h" />
    <ClInclude Include="include\chartgeometry.h" />
    <ClInclude Include="include\clocktime.h" />
    <ClInclude Include="include\csvseriesparser.h" />
    <ClInclude Include="include\csvserieswriter.h" />
    <ClInclude Include="include\frameprocessor.h" />
    <ClInclude Include="include\framesetup.h" />
    <ClInclude Include="include\framesync.h" />
    <ClInclude Include="include\framesyncfile.h" />
    <ClInclude Include="include\intervalgate.h" />
    <ClInclude Include="include\irig106lock.h" />
    <ClInclude Include="include\packetqueue.h" />
    <ClInclude Include="include\pipelinerunner.h" />
    <ClInclude Include="include\receivernames.h" />
    <ClInclude Include="include\receiverparamsfile.h" />
    <ClInclude Include="include\processingevents.h" />
    <ClInclude Include="include\seriesbuilder.h" />
    <ClInclude Include="include\seriescolumnschema.h" />
    <ClInclude Include="include\seriesrange.h" />
    <ClInclude Include="include\stepconfigfile.h" />
    <ClInclude Include="include\stepdetector.h" />
    <ClInclude Include="include\stepplateaus.h" />
    <ClInclude Include="include\stepsaturated.h" />
    <ClInclude Include="include\streamjobbuilder.h" />
    <ClInclude Include="include\templatematcher.h" />
    <ClInclude Include="include\textfile.h" />
    <ClInclude Include="include\tomldocument.h" />
  </ItemGroup>

  <ItemGroup>
    <ClInclude Include="abi\tmdq_abi.h" />
    <ClInclude Include="abi\abi_internal.h" />
    <ClInclude Include="abi\abi_events.h" />
  </ItemGroup>

  <!-- The ABI itself. -->
  <ItemGroup>
    <ClCompile Include="abi\tmdq_core.cpp" />
    <ClCompile Include="abi\abi_file.cpp" />
    <ClCompile Include="abi\abi_run.cpp" />
    <ClCompile Include="abi\abi_calibration.cpp" />
    <ClCompile Include="abi\abi_chart.cpp" />
    <ClCompile Include="abi\abi_formats.cpp" />
    <ClCompile Include="abi\abi_series.cpp" />
  </ItemGroup>

  <!-- The core: every source in src\core\src (NativeProjectTests holds this list to the folder). -->
  <ItemGroup>
    <ClCompile Include="src\calibrationextractor.cpp" />
    <ClCompile Include="src\calibrationrequest.cpp" />
    <ClCompile Include="src\chartgeometry.cpp" />
    <ClCompile Include="src\ch10packetreader.cpp" />
    <ClCompile Include="src\ch10setup.cpp" />
    <ClCompile Include="src\channeldata.cpp" />
    <ClCompile Include="src\chapter10reader.cpp" />
    <ClCompile Include="src\clocktime.cpp" />
    <ClCompile Include="src\csvseriesparser.cpp" />
    <ClCompile Include="src\csvserieswriter.cpp" />
    <ClCompile Include="src\frameprocessor.cpp" />
    <ClCompile Include="src\framesetup.cpp" />
    <ClCompile Include="src\framesyncfile.cpp" />
    <ClCompile Include="src\pipelinerunner.cpp" />
    <ClCompile Include="src\receivernames.cpp" />
    <ClCompile Include="src\receiverparamsfile.cpp" />
    <ClCompile Include="src\seriesbuilder.cpp" />
    <ClCompile Include="src\seriescolumnschema.cpp" />
    <ClCompile Include="src\stepconfigfile.cpp" />
