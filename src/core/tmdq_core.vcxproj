    <ClCompile Include="src\stepplateaus.cpp" />
    <ClCompile Include="src\stepsaturated.cpp" />
    <ClCompile Include="src\streamjobbuilder.cpp" />
    <ClCompile Include="src\templatematcher.cpp" />
    <ClCompile Include="src\textfile.cpp" />
    <ClCompile Include="src\tomldocument.cpp" />
  </ItemGroup>

  <!-- The vendored irig106 library: plain C, third-party, no warnings. In dependency order. -->
  <ItemGroup>
    <ClCompile Include="..\..\third_party\irig106\src\irig106ch10.c" />
    <ClCompile Include="..\..\third_party\irig106\src\i106_time.c" />
    <ClCompile Include="..\..\third_party\irig106\src\i106_data_stream.c" />
    <ClCompile Include="..\..\third_party\irig106\src\i106_decode_time.c" />
    <ClCompile Include="..\..\third_party\irig106\src\i106_decode_tmats.c" />
    <ClCompile Include="..\..\third_party\irig106\src\i106_decode_tmats_g.c" />
    <ClCompile Include="..\..\third_party\irig106\src\i106_decode_tmats_r.c" />
    <ClCompile Include="..\..\third_party\irig106\src\i106_decode_tmats_m.c" />
    <ClCompile Include="..\..\third_party\irig106\src\i106_decode_tmats_p.c" />
    <ClCompile Include="..\..\third_party\irig106\src\i106_decode_tmats_b.c" />
    <ClCompile Include="..\..\third_party\irig106\src\i106_decode_tmats_c.c" />
    <ClCompile Include="..\..\third_party\irig106\src\i106_decode_tmats_d.c" />
    <ClCompile Include="..\..\third_party\irig106\src\i106_decode_pcmf1.c" />
  </ItemGroup>
  <ItemGroup>
    <ClCompile Update="..\..\third_party\irig106\src\*.c">
      <WarningLevel>TurnOffAllWarnings</WarningLevel>
      <CompileAs>CompileAsC</CompileAs>
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
