<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TmDq.App.ViewModels"
             x:Class="TmDq.App.App"
             RequestedThemeVariant="Default">
  <Application.Styles>
    <!-- VS Code's Dark Modern and Light Modern colours (the accent and the text), so the controls Fluent draws agree with
         the brushes below. -->
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#005FB8" RegionColor="#FFFFFF" BaseHigh="#3B3B3B" />
        <ColorPaletteResources x:Key="Dark" Accent="#0078D4" RegionColor="#1F1F1F" BaseHigh="#CCCCCC" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <!-- Customize View's colour dialog (plan step 4.4). -->
    <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />
    <!-- Every window's icon, for its title bar and Alt+Tab: a window takes its own, not the exe's; and every window's
         background: the layer colour (the chart's), so a dialog is on the surface its plot is. The main window sets
         its own, the base colour, to be the colour of its title bar and log. `:is(Window)` reaches every window kind by its
         type. A plain `Window` selector does as well, but only because Window gives every subclass its own style key
         (StyleKeyOverride), which a window of ours could override. -->
    <Style Selector=":is(Window)">
      <Setter Property="Icon" Value="/Assets/icon.ico" />
      <Setter Property="Background" Value="{DynamicResource LayerFillColorDefaultBrush}" />
    </Style>
    <!-- A menu's rows are inset 4 px from its edges, so a row's highlight sits inside it, rounded (VS Code's menus), the main
         menu's and the plot's. (The template sets its items' presenter's margin itself, which a style cannot change.) -->
    <Style Selector="MenuItem">
      <Setter Property="Margin" Value="4,0" />
    </Style>
  </Application.Styles>
  <Application.Resources>
    <ResourceDictionary>
      <!-- The entries of a menu that come from the data (a MenuChoice each): Recent Files, and the plot's Plot File and
           Readout. A choice whose header is "-" is drawn as the menu's separator. -->
      <ControlTheme x:Key="MenuChoice" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="vm:MenuChoice">
        <Setter Property="Header" Value="{Binding Header}" />
        <Setter Property="Command" Value="{Binding Command}" />
        <Setter Property="CommandParameter" Value="{Binding Parameter}" />
        <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
        <Setter Property="ToolTip.Tip" Value="{Binding Tip}" />
      </ControlTheme>
      <!-- One of a menu's choices, the one chosen checked. -->
      <ControlTheme x:Key="RadioChoice" TargetType="MenuItem" BasedOn="{StaticResource MenuChoice}" x:DataType="vm:MenuChoice">
        <Setter Property="ToggleType" Value="Radio" />
        <Setter Property="IsChecked" Value="{Binding IsChecked, Mode=OneWay}" />
      </ControlTheme>
      <!-- The type, the corners and the colours the application is built on: Fluent's (Windows 11's), in VS Code's Dark Modern
           and Light Modern values. The font is Segoe UI Variable, which Fluent draws Windows 11 in (Avalonia's Fluent theme
           asks for Inter, which this application does not bundle, so it fell back to the system's Segoe UI); the type scale is Fluent's (caption 12, body 14), and the corners are Fluent's, 4 px for a
           control and 8 for an overlay (Avalonia's are 3 and 5). The colours are Fluent's semantic tokens, a Color each and
           the Brush over it (SolidBackgroundFillColorBase: the window, title bar and log; LayerFillColorDefault: the chart and
           every dialog; the strokes, fills and text between), so that a control Fluent draws, or one we add, is on the token
           for its job. The brushes Fluent looks its controls up under (TextControl*, ComboBox*, Button*, CheckBox*,
           MenuFlyoutPresenter*, MenuFlyoutItem*, ToolTip*) are aliases of the tokens, never colours of their own. The accent and text of
           Fluent's own controls come from the palettes on FluentTheme. The chart and its legend take theirs from
           ChartPalette. -->
      <FontFamily x:Key="ContentControlThemeFontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>
      <x:Double x:Key="CaptionTextBlockFontSize">12</x:Double>
      <x:Double x:Key="BodyTextBlockFontSize">14</x:Double>
      <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
      <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>
      <!-- A menu as VS Code draws it: compact rows (28 px high), 12 px of text padding at the sides. -->
      <Thickness x:Key="MenuFlyoutItemThemePadding">12,4,12,5</Thickness>
      <Thickness x:Key="MenuFlyoutItemThemePaddingNarrow">12,4,12,5</Thickness>
      <!-- A dialog's anatomy, Fluent's ContentDialog: 24 px round the content, a footer band below it with the buttons 8 px
           apart (the spacing grid is 4 px). -->
      <Thickness x:Key="ContentDialogPadding">24</Thickness>
      <x:Double x:Key="ContentDialogButtonSpacing">8</x:Double>
      <x:Double x:Key="ContentDialogButtonMinWidth">96</x:Double>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <!-- Fluent's semantic tokens, in VS Code's values: a Color each, and the Brush over it. -->
          <Color x:Key="SolidBackgroundFillColorBase">#F8F8F8</Color>
          <Color x:Key="LayerFillColorDefault">#FFFFFF</Color>
          <Color x:Key="CardBackgroundFillColorDefault">#F8F8F8</Color>
          <Color x:Key="ControlFillColorDefault">#FFFFFF</Color>
          <Color x:Key="ButtonFillColorDefault">#E5E5E5</Color>
          <Color x:Key="ButtonFillColorHover">#CCCCCC</Color>
          <Color x:Key="SubtleFillColorSecondary">#38808080</Color>
          <Color x:Key="ControlStrokeColorDefault">#CECECE</Color>
          <Color x:Key="ButtonStrokeColorDefault">#1A000000</Color>
          <Color x:Key="DividerStrokeColorDefault">#E5E5E5</Color>
          <Color x:Key="SurfaceStrokeColorDefault">#E5E5E5</Color>
          <Color x:Key="TextFillColorPrimary">#3B3B3B</Color>
          <Color x:Key="TextFillColorSecondary">#616161</Color>
          <Color x:Key="AccentFillColorDefault">#005FB8</Color>
          <Color x:Key="AccentTextFillColorPrimary">#005FB8</Color>
          <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="{DynamicResource SolidBackgroundFillColorBase}" />
          <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="{DynamicResource LayerFillColorDefault}" />
          <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="{DynamicResource CardBackgroundFillColorDefault}" />
          <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="{DynamicResource ControlFillColorDefault}" />
          <SolidColorBrush x:Key="ButtonFillColorDefaultBrush" Color="{DynamicResource ButtonFillColorDefault}" />
          <SolidColorBrush x:Key="ButtonFillColorHoverBrush" Color="{DynamicResource ButtonFillColorHover}" />
          <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="{DynamicResource SubtleFillColorSecondary}" />
          <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="{DynamicResource ControlStrokeColorDefault}" />
          <SolidColorBrush x:Key="ButtonStrokeColorDefaultBrush" Color="{DynamicResource ButtonStrokeColorDefault}" />
          <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="{DynamicResource DividerStrokeColorDefault}" />
          <SolidColorBrush x:Key="SurfaceStrokeColorDefaultBrush" Color="{DynamicResource SurfaceStrokeColorDefault}" />
          <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{DynamicResource TextFillColorPrimary}" />
          <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{DynamicResource TextFillColorSecondary}" />
          <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{DynamicResource AccentFillColorDefault}" />
          <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="{DynamicResource AccentTextFillColorPrimary}" />
          <Color x:Key="TextOnAccentFillColorPrimary">#FFFFFF</Color>
          <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="{DynamicResource TextOnAccentFillColorPrimary}" />
          <Color x:Key="SystemFillColorSuccess">#0F7B0F</Color>
          <Color x:Key="SystemFillColorCaution">#9D5D00</Color>
          <Color x:Key="SystemFillColorCritical">#C42B1C</Color>
          <Color x:Key="SystemFillColorNeutral">#72000000</Color>
          <SolidColorBrush x:Key="SystemFillColorSuccessBrush" Color="{DynamicResource SystemFillColorSuccess}" />
          <SolidColorBrush x:Key="SystemFillColorCautionBrush" Color="{DynamicResource SystemFillColorCaution}" />
          <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="{DynamicResource SystemFillColorCritical}" />
          <SolidColorBrush x:Key="SystemFillColorNeutralBrush" Color="{DynamicResource SystemFillColorNeutral}" />
          <!-- What the application draws itself: the chips and the "Loading..." label over the chart. -->
          <SolidColorBrush x:Key="ChipBackground" Color="#B9FFFFFF" />
          <SolidColorBrush x:Key="ChipBorder" Color="{DynamicResource ControlStrokeColorDefault}" />
          <SolidColorBrush x:Key="ChipForeground" Color="{DynamicResource TextFillColorPrimary}" />
          <SolidColorBrush x:Key="ChipAccent" Color="{DynamicResource AccentTextFillColorPrimary}" />
          <SolidColorBrush x:Key="LoadingBackground" Color="#F2F8F8F8" />
          <SolidColorBrush x:Key="LoadingBorder" Color="{DynamicResource SurfaceStrokeColorDefault}" />
          <SolidColorBrush x:Key="LoadingForeground" Color="{DynamicResource TextFillColorPrimary}" />
          <!-- The controls Fluent draws, by the brushes it looks them up under, each on a token. -->
          <SolidColorBrush x:Key="TextControlBackground" Color="{DynamicResource ControlFillColorDefault}" />
          <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="{DynamicResource ControlFillColorDefault}" />
          <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="{DynamicResource ControlFillColorDefault}" />
          <SolidColorBrush x:Key="ComboBoxBackground" Color="{DynamicResource ControlFillColorDefault}" />
          <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="{DynamicResource ControlFillColorDefault}" />
          <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="{DynamicResource ControlFillColorDefault}" />
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUnchecked" Color="{DynamicResource ControlFillColorDefault}" />
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUncheckedPointerOver" Color="{DynamicResource ControlFillColorDefault}" />
          <SolidColorBrush x:Key="TextControlBorderBrush" Color="{DynamicResource ControlStrokeColorDefault}" />
          <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="{DynamicResource ControlStrokeColorDefault}" />
          <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="{DynamicResource ControlStrokeColorDefault}" />
          <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="{DynamicResource ControlStrokeColorDefault}" />
          <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="{DynamicResource ControlStrokeColorDefault}" />
          <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="{DynamicResource ControlStrokeColorDefault}" />
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUnchecked" Color="{DynamicResource ControlStrokeColorDefault}" />
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedPointerOver" Color="{DynamicResource ControlStrokeColorDefault}" />
          <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="{DynamicResource ControlStrokeColorDefault}" />
          <SolidColorBrush x:Key="ToolTipBorderBrush" Color="{DynamicResource ControlStrokeColorDefault}" />
          <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="{DynamicResource LayerFillColorDefault}" />
          <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="{DynamicResource LayerFillColorDefault}" />
          <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="{DynamicResource AccentFillColorDefault}" />
          <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPressed" Color="{DynamicResource AccentFillColorDefault}" />
          <SolidColorBrush x:Key="MenuFlyoutItemForegroundPointerOver" Color="{DynamicResource TextOnAccentFillColorPrimary}" />
          <SolidColorBrush x:Key="MenuFlyoutItemForegroundPressed" Color="{DynamicResource TextOnAccentFillColorPrimary}" />
          <SolidColorBrush x:Key="MenuFlyoutItemKeyboardAcceleratorTextForeground" Color="{DynamicResource TextFillColorSecondary}" />
          <SolidColorBrush x:Key="MenuFlyoutItemKeyboardAcceleratorTextForegroundPointerOver" Color="{DynamicResource TextOnAccentFillColorPrimary}" />
          <SolidColorBrush x:Key="MenuFlyoutItemKeyboardAcceleratorTextForegroundPressed" Color="{DynamicResource TextOnAccentFillColorPrimary}" />
          <SolidColorBrush x:Key="MenuFlyoutSubItemChevronPointerOver" Color="{DynamicResource TextOnAccentFillColorPrimary}" />
          <SolidColorBrush x:Key="MenuFlyoutSubItemChevronPressed" Color="{DynamicResource TextOnAccentFillColorPrimary}" />
          <SolidColorBrush x:Key="MenuFlyoutSubItemChevronSubMenuOpened" Color="{DynamicResource TextOnAccentFillColorPrimary}" />
          <SolidColorBrush x:Key="ToolTipBackground" Color="{DynamicResource CardBackgroundFillColorDefault}" />
          <SolidColorBrush x:Key="ButtonBackground" Color="{DynamicResource ButtonFillColorDefault}" />
          <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{DynamicResource ButtonFillColorHover}" />
          <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{DynamicResource ButtonFillColorHover}" />
          <SolidColorBrush x:Key="ButtonBorderBrush" Color="{DynamicResource ButtonStrokeColorDefault}" />
          <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="{DynamicResource ButtonStrokeColorDefault}" />
          <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="{DynamicResource ButtonStrokeColorDefault}" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <!-- Fluent's semantic tokens, in VS Code's values: a Color each, and the Brush over it. -->
          <Color x:Key="SolidBackgroundFillColorBase">#181818</Color>
          <Color x:Key="LayerFillColorDefault">#1F1F1F</Color>
          <Color x:Key="CardBackgroundFillColorDefault">#202020</Color>
          <Color x:Key="ControlFillColorDefault">#313131</Color>
          <Color x:Key="ButtonFillColorDefault">#00000000</Color>
          <Color x:Key="ButtonFillColorHover">#2B2B2B</Color>
          <Color x:Key="SubtleFillColorSecondary">#38808080</Color>
          <Color x:Key="ControlStrokeColorDefault">#3C3C3C</Color>
          <Color x:Key="ButtonStrokeColorDefault">#1AFFFFFF</Color>
          <Color x:Key="DividerStrokeColorDefault">#2B2B2B</Color>
          <Color x:Key="SurfaceStrokeColorDefault">#313131</Color>
          <Color x:Key="TextFillColorPrimary">#CCCCCC</Color>
          <Color x:Key="TextFillColorSecondary">#9D9D9D</Color>
          <Color x:Key="AccentFillColorDefault">#0078D4</Color>
          <Color x:Key="AccentTextFillColorPrimary">#4DAAFC</Color>
          <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="{DynamicResource SolidBackgroundFillColorBase}" />
          <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="{DynamicResource LayerFillColorDefault}" />
          <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="{DynamicResource CardBackgroundFillColorDefault}" />
          <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="{DynamicResource ControlFillColorDefault}" />
          <SolidColorBrush x:Key="ButtonFillColorDefaultBrush" Color="{DynamicResource ButtonFillColorDefault}" />
          <SolidColorBrush x:Key="ButtonFillColorHoverBrush" Color="{DynamicResource ButtonFillColorHover}" />
          <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="{DynamicResource SubtleFillColorSecondary}" />
          <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="{DynamicResource ControlStrokeColorDefault}" />
          <SolidColorBrush x:Key="ButtonStrokeColorDefaultBrush" Color="{DynamicResource ButtonStrokeColorDefault}" />
          <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="{DynamicResource DividerStrokeColorDefault}" />
          <SolidColorBrush x:Key="SurfaceStrokeColorDefaultBrush" Color="{DynamicResource SurfaceStrokeColorDefault}" />
          <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{DynamicResource TextFillColorPrimary}" />
          <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{DynamicResource TextFillColorSecondary}" />
          <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{DynamicResource AccentFillColorDefault}" />
          <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="{DynamicResource AccentTextFillColorPrimary}" />
          <Color x:Key="TextOnAccentFillColorPrimary">#FFFFFF</Color>
          <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="{DynamicResource TextOnAccentFillColorPrimary}" />
          <Color x:Key="SystemFillColorSuccess">#6CCB5F</Color>
          <Color x:Key="SystemFillColorCaution">#FCE100</Color>
          <Color x:Key="SystemFillColorCritical">#FF99A4</Color>
          <Color x:Key="SystemFillColorNeutral">#9CFFFFFF</Color>
          <SolidColorBrush x:Key="SystemFillColorSuccessBrush" Color="{DynamicResource SystemFillColorSuccess}" />
          <SolidColorBrush x:Key="SystemFillColorCautionBrush" Color="{DynamicResource SystemFillColorCaution}" />
          <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="{DynamicResource SystemFillColorCritical}" />
          <SolidColorBrush x:Key="SystemFillColorNeutralBrush" Color="{DynamicResource SystemFillColorNeutral}" />
          <!-- What the application draws itself: the chips and the "Loading..." label over the chart. -->
          <SolidColorBrush x:Key="ChipBackground" Color="#B91F1F1F" />
          <SolidColorBrush x:Key="ChipBorder" Color="{DynamicResource ControlStrokeColorDefault}" />
          <SolidColorBrush x:Key="ChipForeground" Color="{DynamicResource TextFillColorPrimary}" />
          <SolidColorBrush x:Key="ChipAccent" Color="{DynamicResource AccentTextFillColorPrimary}" />
          <SolidColorBrush x:Key="LoadingBackground" Color="#F2202020" />
          <SolidColorBrush x:Key="LoadingBorder" Color="{DynamicResource SurfaceStrokeColorDefault}" />
          <SolidColorBrush x:Key="LoadingForeground" Color="{DynamicResource TextFillColorPrimary}" />
          <!-- The controls Fluent draws, by the brushes it looks them up under, each on a token. -->
          <SolidColorBrush x:Key="TextControlBackground" Color="{DynamicResource ControlFillColorDefault}" />
          <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="{DynamicResource ControlFillColorDefault}" />
          <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="{DynamicResource ControlFillColorDefault}" />
          <SolidColorBrush x:Key="ComboBoxBackground" Color="{DynamicResource ControlFillColorDefault}" />
          <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="{DynamicResource ControlFillColorDefault}" />
          <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="{DynamicResource ControlFillColorDefault}" />
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUnchecked" Color="{DynamicResource ControlFillColorDefault}" />
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUncheckedPointerOver" Color="{DynamicResource ControlFillColorDefault}" />
          <SolidColorBrush x:Key="TextControlBorderBrush" Color="{DynamicResource ControlStrokeColorDefault}" />
          <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="{DynamicResource ControlStrokeColorDefault}" />
          <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="{DynamicResource ControlStrokeColorDefault}" />
          <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="{DynamicResource ControlStrokeColorDefault}" />
          <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="{DynamicResource ControlStrokeColorDefault}" />
          <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="{DynamicResource ControlStrokeColorDefault}" />
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUnchecked" Color="{DynamicResource ControlStrokeColorDefault}" />
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedPointerOver" Color="{DynamicResource ControlStrokeColorDefault}" />
          <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="{DynamicResource ControlStrokeColorDefault}" />
          <SolidColorBrush x:Key="ToolTipBorderBrush" Color="{DynamicResource ControlStrokeColorDefault}" />
          <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="{DynamicResource LayerFillColorDefault}" />
          <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="{DynamicResource LayerFillColorDefault}" />
          <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="{DynamicResource AccentFillColorDefault}" />
          <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPressed" Color="{DynamicResource AccentFillColorDefault}" />
          <SolidColorBrush x:Key="MenuFlyoutItemForegroundPointerOver" Color="{DynamicResource TextOnAccentFillColorPrimary}" />
          <SolidColorBrush x:Key="MenuFlyoutItemForegroundPressed" Color="{DynamicResource TextOnAccentFillColorPrimary}" />
          <SolidColorBrush x:Key="MenuFlyoutItemKeyboardAcceleratorTextForeground" Color="{DynamicResource TextFillColorSecondary}" />
          <SolidColorBrush x:Key="MenuFlyoutItemKeyboardAcceleratorTextForegroundPointerOver" Color="{DynamicResource TextOnAccentFillColorPrimary}" />
          <SolidColorBrush x:Key="MenuFlyoutItemKeyboardAcceleratorTextForegroundPressed" Color="{DynamicResource TextOnAccentFillColorPrimary}" />
          <SolidColorBrush x:Key="MenuFlyoutSubItemChevronPointerOver" Color="{DynamicResource TextOnAccentFillColorPrimary}" />
          <SolidColorBrush x:Key="MenuFlyoutSubItemChevronPressed" Color="{DynamicResource TextOnAccentFillColorPrimary}" />
          <SolidColorBrush x:Key="MenuFlyoutSubItemChevronSubMenuOpened" Color="{DynamicResource TextOnAccentFillColorPrimary}" />
          <SolidColorBrush x:Key="ToolTipBackground" Color="{DynamicResource CardBackgroundFillColorDefault}" />
          <SolidColorBrush x:Key="ButtonBackground" Color="{DynamicResource ButtonFillColorDefault}" />
          <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{DynamicResource ButtonFillColorHover}" />
          <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{DynamicResource ButtonFillColorHover}" />
          <SolidColorBrush x:Key="ButtonBorderBrush" Color="{DynamicResource ButtonStrokeColorDefault}" />
          <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="{DynamicResource ButtonStrokeColorDefault}" />
          <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="{DynamicResource ButtonStrokeColorDefault}" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
