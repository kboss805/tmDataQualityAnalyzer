<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TmDq.App.ViewModels"
        xmlns:views="using:TmDq.App.Views"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        x:Class="TmDq.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Width="1920" Height="1080" WindowStartupLocation="CenterScreen"
        MinWidth="640" MinHeight="400"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="BorderOnly"
        ExtendClientAreaTitleBarHeightHint="40"
        Background="{DynamicResource WindowBackground}"
        DragDrop.AllowDrop="True">
  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenCommand}" />
    <KeyBinding Gesture="Ctrl+B" Command="{Binding ToggleSidebarCommand}" />
  </Window.KeyBindings>
  <Window.Styles>
    <!-- The title bar's buttons: borderless glyphs with a soft hover, as v2.x drew them. -->
    <Style Selector="Grid#TitleBar Button">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="26" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Grid#TitleBar Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource TitleBarHover}" />
    </Style>
    <Style Selector="Grid#TitleBar Button.caption">
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
      <Setter Property="FontSize" Value="10" />
    </Style>
    <Style Selector="Grid#TitleBar Button.glyph">
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
      <Setter Property="FontSize" Value="15" />
    </Style>
    <Style Selector="Grid#TitleBar Button#CloseButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#C42B1C" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <!-- The sidebar toggle is a glyph like the others, shown or not, never the theme's filled "checked" button. -->
    <Style Selector="Grid#TitleBar ToggleButton:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource ToggleButtonForeground}" />
    </Style>
    <Style Selector="Grid#TitleBar ToggleButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource TitleBarHover}" />
      <Setter Property="Foreground" Value="{DynamicResource ToggleButtonForeground}" />
    </Style>
    <!-- The divider between the log and the chart: a short grip, a shade off the window's background, that says where to
         drag; under the pointer, or dragged, the strip takes a shade too and the grip brightens. -->
    <Style Selector="GridSplitter#Splitter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="Track" Background="{TemplateBinding Background}" CornerRadius="3">
            <Border Name="Grip" Width="2" Height="36" CornerRadius="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource SplitterGrip}" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="GridSplitter#Splitter:pointerover, GridSplitter#Splitter:pressed">
      <Setter Property="Background" Value="{DynamicResource SplitterHover}" />
    </Style>
    <Style Selector="GridSplitter#Splitter:pointerover /template/ Border#Grip, GridSplitter#Splitter:pressed /template/ Border#Grip">
      <Setter Property="Background" Value="{DynamicResource SplitterGripHover}" />
    </Style>
    <!-- The log and the chart each sit in a panel of the same shape: a hairline border and rounded corners, set off from
         the window's edges by the same gap (the chart is clipped to the corners in code: a Border does not clip). -->
    <Style Selector="Border.panel">
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="BorderBrush" Value="{DynamicResource LogPanelBorder}" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
  </Window.Styles>
  <DockPanel>
    <!-- The title bar (plan step 4.8), where the system's was: the menu and the sidebar toggle on the left, the window's
         buttons on the right, and between them the caption that drags, snaps and maximizes on a double-click. Each part
         tells Windows what it is (its element role): the maximize button as the maximize button, which is what makes
         Windows 11 offer its snap layouts on a hover. -->
    <Grid x:Name="TitleBar" x:FieldModifier="public" DockPanel.Dock="Top" Height="40" ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto"
          Margin="2,0,6,0">
      <Button x:Name="MenuButton" x:FieldModifier="public" Grid.Column="0" Classes="glyph" Content="&#xE700;" ToolTip.Tip="Menu"
              chrome:WindowDecorationProperties.ElementRole="User">
        <!-- The menu, as v2.x's: the Process section (Open, Recent Files, Save as Template, Apply Template to Files), the
             Import/Export section (Import CSV, Export), the Settings section (the theme), then Help (User Manual, About)
             and Exit, each set off by a separator. Every entry is available as its command is. A section's heading is a
             disabled item in the application's "section" style. -->
        <Button.Flyout>
          <MenuFlyout Placement="BottomEdgeAlignedLeft">
            <MenuItem Header="Process" IsEnabled="False" Classes="section" />
            <MenuItem Header="Open..." Command="{Binding OpenCommand}" InputGesture="Ctrl+O">
              <MenuItem.Icon><Image Source="{DynamicResource OpenIcon}" Width="16" Height="16" /></MenuItem.Icon>
            </MenuItem>
            <!-- Each by its name, its path as the tooltip, newest first, then Clear Recent Files; or "(No recent files)",
                 disabled. -->
            <MenuItem Header="Recent Files" ItemsSource="{Binding RecentMenu}" ItemContainerTheme="{StaticResource MenuChoice}" />
            <MenuItem Header="Save as Template..." Command="{Binding SaveTemplateCommand}"
                      ToolTip.Tip="Save the processed recording's stream settings, names and colors as a template">
              <MenuItem.Icon><Image Source="{DynamicResource SaveIcon}" Width="16" Height="16" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Apply Template to Files..." Command="{Binding ApplyTemplateCommand}"
                      ToolTip.Tip="Process several recordings with a saved template" />
            <MenuItem Header="Import/Export" IsEnabled="False" Classes="section" />
            <MenuItem Header="Import CSV..." Command="{Binding ImportCsvCommand}" ToolTip.Tip="Import a previously exported CSV file">
              <MenuItem.Icon><Image Source="{DynamicResource ImportIcon}" Width="16" Height="16" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Export..." Command="{Binding ExportCommand}" ToolTip.Tip="Export plot data and images">
              <MenuItem.Icon><Image Source="{DynamicResource ExportIcon}" Width="16" Height="16" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Settings" IsEnabled="False" Classes="section" />
            <MenuItem Header="{Binding ThemeMenuText}" Command="{Binding ToggleThemeCommand}" />
            <Separator />
            <MenuItem Header="Help">
              <MenuItem Header="User Manual..." Click="OnUserManual" />
              <MenuItem Header="About..." Click="OnAbout" />
            </MenuItem>
            <Separator />
            <MenuItem Header="Exit" Click="OnExit" />
          </MenuFlyout>
        </Button.Flyout>
      </Button>
      <!-- A ToggleButton, which the title bar's Button styles do not reach: it sets their size and centring itself. -->
      <ToggleButton x:Name="SidebarButton" x:FieldModifier="public" Grid.Column="1" Width="30" Height="26" Padding="0"
                    VerticalAlignment="Center" Background="Transparent" BorderThickness="0" CornerRadius="5"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" Content="&#xE89F;"
                    IsChecked="{Binding SidebarVisible}" ToolTip.Tip="Toggle sidebar (Ctrl+B)"
                    chrome:WindowDecorationProperties.ElementRole="User" />
      <Border x:Name="Caption" x:FieldModifier="public" Grid.Column="2" Background="Transparent"
              chrome:WindowDecorationProperties.ElementRole="TitleBar" />
      <Button x:Name="MinimizeButton" x:FieldModifier="public" Grid.Column="3" Classes="caption" Content="&#xE921;" ToolTip.Tip="Minimize"
              Click="OnMinimize" chrome:WindowDecorationProperties.ElementRole="MinimizeButton" />
      <Button x:Name="MaximizeButton" x:FieldModifier="public" Grid.Column="4" Classes="caption" Content="&#xE922;" ToolTip.Tip="Maximize"
              Click="OnMaximize" chrome:WindowDecorationProperties.ElementRole="MaximizeButton" />
      <Button x:Name="CloseButton" x:FieldModifier="public" Grid.Column="5" Classes="caption" Content="&#xE8BB;" ToolTip.Tip="Close"
              Click="OnClose" chrome:WindowDecorationProperties.ElementRole="CloseButton" />
    </Grid>
    <!-- No status bar under the log and the chart: what it said, the log says (the version is the log's first line).
         The log sidebar on the left (v2.x's place and width), the chart beside it; the toggle in the title bar hides it.
         The divider drags the log as narrow as its column's minimum, and the log wraps to the width it is given (the
         minimum is the column's, not the panel's: a panel wider than its column was cut off at both edges). Progress is
         in the modal progress dialog while a run goes on, as in v2.x. -->
    <Grid x:Name="Body" x:FieldModifier="public">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="400" MinWidth="200" />
        <ColumnDefinition Width="6" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border x:Name="LogPanel" Classes="panel" Grid.Column="0" Margin="2,4,0,4" Background="{DynamicResource LogPanelBackground}"
              IsVisible="{Binding SidebarVisible}">
        <views:LogView x:Name="Log" Entries="{Binding Log.Entries}" />
      </Border>
      <GridSplitter x:Name="Splitter" x:FieldModifier="public" Grid.Column="1" ResizeDirection="Columns"
                    IsVisible="{Binding SidebarVisible}" />
      <Border x:Name="PlotPanel" x:FieldModifier="public" Classes="panel" Grid.Column="2" Margin="0,4,2,4">
        <views:PlotView x:Name="PlotView" Plot="{Binding Plot}" />
      </Border>
    </Grid>
  </DockPanel>
</Window>
