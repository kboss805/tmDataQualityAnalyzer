<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TmDq.App.ViewModels.Dialogs"
        xmlns:c="using:TmDq.App.Views.Controls"
        x:Class="TmDq.App.Views.Dialogs.ExportWindow"
        x:DataType="vm:ExportViewModel"
        Title="{x:Static vm:ExportViewModel.Title}"
        MinWidth="500" Width="560" SizeToContent="Height" CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <Window.Styles>
    <Style Selector="HeaderedContentControl.group">
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
  </Window.Styles>
  <!-- As v2.x laid it out: the plot image first (the default export), then the data, then the log. -->
  <DockPanel>
    <c:DialogFooter DockPanel.Dock="Bottom">
      <Button x:Name="ExportButton" Content="Export" IsDefault="True" Command="{Binding ExportCommand}" />
      <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" Command="{Binding CancelCommand}" />
    </c:DialogFooter>
  <StackPanel Margin="{DynamicResource ContentDialogPadding}" Spacing="2">
    <HeaderedContentControl Classes="group" Header="Export Plot Image">
      <StackPanel Spacing="4">
        <CheckBox x:Name="ImageBox" Content="Export Image" IsChecked="{Binding ExportImage}" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <TextBox x:Name="ImagePathBox" Text="{Binding ImagePath}" IsEnabled="{Binding ExportImage}" />
          <Button x:Name="ImageBrowse" Grid.Column="1" Content="Browse..." Command="{Binding BrowseImageCommand}" />
        </Grid>
      </StackPanel>
    </HeaderedContentControl>
    <HeaderedContentControl Classes="group" Header="Export Data (CSV)">
      <StackPanel Spacing="4">
        <CheckBox x:Name="DataBox" Content="Export Data" IsChecked="{Binding ExportData}" IsEnabled="{Binding DataAvailable}" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <TextBox x:Name="DataPathBox" Text="{Binding DataPath}" IsEnabled="{Binding ExportData}" />
          <Button x:Name="DataBrowse" Grid.Column="1" Content="Browse..." Command="{Binding BrowseDataCommand}" />
        </Grid>
        <!-- An antenna's log alone: its own system writes it, so there is nothing to export (US10.0). -->
        <TextBlock x:Name="DataUnavailableNote" IsVisible="{Binding !DataAvailable}" Opacity="0.7" TextWrapping="Wrap"
                   Text="Nothing to export: a phased array antenna's log is never exported." />
      </StackPanel>
    </HeaderedContentControl>
    <HeaderedContentControl Classes="group" Header="Export Log (Text)">
      <StackPanel Spacing="4">
        <CheckBox Content="Export Log" IsChecked="{Binding ExportLog}" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <TextBox x:Name="LogPathBox" Text="{Binding LogPath}" IsEnabled="{Binding ExportLog}" />
          <Button x:Name="LogBrowse" Grid.Column="1" Content="Browse..." Command="{Binding BrowseLogCommand}" />
        </Grid>
      </StackPanel>
    </HeaderedContentControl>
  </StackPanel>
  </DockPanel>
</Window>
