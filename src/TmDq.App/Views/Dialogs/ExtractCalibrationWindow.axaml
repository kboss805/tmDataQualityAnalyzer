<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TmDq.App.ViewModels.Dialogs"
        xmlns:c="using:TmDq.App.Views.Controls"
        xmlns:cv="using:TmDq.App.Views.Converters"
        x:Class="TmDq.App.Views.Dialogs.ExtractCalibrationWindow"
        x:DataType="vm:ExtractCalibrationViewModel"
        Title="{x:Static vm:ExtractCalibrationViewModel.Title}"
        SizeToContent="WidthAndHeight"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <!-- As v2.x laid it out: the step file, the calibration recording, each with its status beneath, then the clips. -->
  <DockPanel>
    <c:DialogFooter DockPanel.Dock="Bottom">
      <Button x:Name="OkButton" Content="OK" IsDefault="True" Command="{Binding OkCommand}" />
      <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" Command="{Binding CancelCommand}" />
    </c:DialogFooter>
  <StackPanel Margin="{DynamicResource ContentDialogPadding}" Spacing="8" Grid.IsSharedSizeScope="True">
    <Grid RowDefinitions="Auto,Auto,12,Auto,Auto,Auto,16,Auto,Auto" ColumnSpacing="12" RowSpacing="4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Row="0" Grid.Column="0" Text="Step Calibration File:" VerticalAlignment="Center" />
      <TextBlock x:Name="StepName" Grid.Row="0" Grid.Column="1" Text="{Binding StepName}" MinWidth="260" VerticalAlignment="Center" />
      <Button x:Name="BrowseStep" AutomationProperties.Name="Browse for the step calibration file" Grid.Row="0" Grid.Column="2" Content="Browse..." Command="{Binding BrowseStepCommand}"
              ToolTip.Tip="Browse for the step calibration configuration TOML file that defines the RF signal step levels." />
      <TextBlock x:Name="StepStatus" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding StepStatus}"
                 cv:StatusPaint.Level="{Binding StepKind, Converter={x:Static cv:StatusPaint.Calibration}}" TextWrapping="Wrap" MaxWidth="420" />

      <TextBlock Grid.Row="3" Grid.Column="0" Text="Calibration Ch10:" VerticalAlignment="Center" />
      <TextBlock x:Name="CalName" Grid.Row="3" Grid.Column="1" Text="{Binding CalName}" MinWidth="260" VerticalAlignment="Center" />
      <Button x:Name="BrowseCal" AutomationProperties.Name="Browse for the calibration recording" Grid.Row="3" Grid.Column="2" Content="Browse..." Command="{Binding BrowseCalCommand}"
              ToolTip.Tip="Browse for the calibration Chapter 10 recording file. The last folder you used will be remembered." />
      <TextBlock x:Name="CalStatus" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding CalStatus}"
                 cv:StatusPaint.Level="{Binding CalKind, Converter={x:Static cv:StatusPaint.Calibration}}" TextWrapping="Wrap" MaxWidth="420" />

      <!-- The calibration recording's own channels, listed once it is chosen: its step cals can be on another channel
           than the stream's, and its time channel can differ too. One row, so nothing is left between the status line and
           the clips while it is hidden; the label column is shared with the grid above to keep the boxes aligned. -->
      <Grid Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" IsVisible="{Binding HasCalChannels}"
            RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="0" Text="PCM Channel:" VerticalAlignment="Center" />
        <ComboBox x:Name="CalPcmChannel" AutomationProperties.Name="PCM channel of the calibration recording" Grid.Row="0" Grid.Column="1"
                  MinWidth="260" HorizontalAlignment="Left"
                  ItemsSource="{Binding CalPcmItems}" SelectedIndex="{Binding CalPcmIndex}"
                  ToolTip.Tip="The channel of the calibration recording that carries the step cals. It starts on the stream's own channel when the recording has it." />
        <TextBlock Grid.Row="1" Grid.Column="0" Text="Time Channel:" VerticalAlignment="Center" />
        <ComboBox x:Name="CalTimeChannel" AutomationProperties.Name="Time channel of the calibration recording" Grid.Row="1" Grid.Column="1"
                  MinWidth="260" HorizontalAlignment="Left"
                  ItemsSource="{Binding CalTimeItems}" SelectedIndex="{Binding CalTimeIndex}"
                  ToolTip.Tip="The time channel of the calibration recording. It starts on the time channel chosen in Configure Streams when the recording has it." />
        <TextBlock x:Name="ChannelNote" Grid.Row="2" Grid.Column="1" Text="{Binding ChannelNote}" IsVisible="{Binding HasChannelNote}" TextWrapping="Wrap" MaxWidth="420" />
      </Grid>

      <TextBlock Grid.Row="7" Grid.Column="0" Text="Clip Start (s):" VerticalAlignment="Center" />
      <TextBox x:Name="ClipStart" AutomationProperties.Name="Clip Start (s)" Grid.Row="7" Grid.Column="1" Width="150" HorizontalAlignment="Left" Text="{Binding ClipStartText}"
               ToolTip.Tip="Ignore this many seconds at the START of the calibration recording before detecting steps (skips signal-generator turn-on transients)." />
      <TextBlock Grid.Row="8" Grid.Column="0" Text="Clip End (s):" VerticalAlignment="Center" />
      <TextBox x:Name="ClipEnd" AutomationProperties.Name="Clip End (s)" Grid.Row="8" Grid.Column="1" Width="150" HorizontalAlignment="Left" Text="{Binding ClipEndText}"
               ToolTip.Tip="Ignore this many seconds at the END of the calibration recording before detecting steps." />
    </Grid>
    <TextBlock x:Name="ClipProblems" Text="{Binding ClipProblemText}" IsVisible="{Binding HasClipProblem}" TextWrapping="Wrap" MaxWidth="420"
               HorizontalAlignment="Left" Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
  </StackPanel>
  </DockPanel>
</Window>
