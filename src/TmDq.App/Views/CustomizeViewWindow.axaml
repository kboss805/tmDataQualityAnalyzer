<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:plot="using:TmDq.App.Plot"
        x:Class="TmDq.App.Views.CustomizeViewWindow"
        x:DataType="plot:CustomizeViewModel"
        Title="Customize Plot Series"
        Width="560" Height="480" MinWidth="500" MinHeight="400"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <Window.Styles>
    <!-- Fluent's tab headers are display-sized; these are a dialog's. -->
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="MinHeight" Value="32" />
    </Style>
  </Window.Styles>
  <Window.Resources>
    <!-- A receiver's group: its box, then its channels, each in its series' colour, with a menu to rename or recolour. -->
    <DataTemplate x:Key="ReceiverTemplate" x:DataType="plot:ReceiverGroup">
      <Expander IsExpanded="{Binding IsExpanded}" HorizontalAlignment="Stretch" Padding="24,2,4,4">
        <Expander.Header>
          <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked}" IsThreeState="False" Foreground="{Binding Brush}" />
        </Expander.Header>
        <ItemsControl ItemsSource="{Binding Channels}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="plot:ChannelItem">
              <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked}" Foreground="{Binding Brush}"
                        ToolTip.Tip="{Binding ToolTip}">
                <CheckBox.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="Rename series…" Command="{Binding RenameCommand}" />
                    <MenuItem Header="Change color…" Command="{Binding RecolorCommand}" />
                  </ContextMenu>
                </CheckBox.ContextMenu>
              </CheckBox>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Expander>
    </DataTemplate>
  </Window.Resources>

  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button x:Name="OkButton" Content="OK" IsDefault="True" MinWidth="80" HorizontalContentAlignment="Center" />
      <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" MinWidth="80" HorizontalContentAlignment="Center" />
    </StackPanel>
    <TabControl x:Name="Tabs">
      <TabItem Header="Frame Sync Lock Streams">
        <DockPanel Margin="0,8,0,0">
          <TextBlock DockPanel.Dock="Top" Text="{x:Static plot:CustomizeViewModel.LockDescription}" TextWrapping="Wrap" />
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,8">
            <Button x:Name="LockSelectAll" Content="Select All" Command="{Binding SelectAllLockCommand}" />
            <Button x:Name="LockSelectNone" Content="Select None" Command="{Binding SelectNoneLockCommand}" />
          </StackPanel>
          <ScrollViewer MinHeight="200">
            <!-- A row: its box ("CH <id>"), its colour, and its name. -->
            <ItemsControl x:Name="LockRows" ItemsSource="{Binding LockRows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="plot:LockStreamRow">
                  <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="6" Margin="0,2">
                    <CheckBox Grid.Column="0" Content="{Binding Label}" IsChecked="{Binding IsChecked}" MinWidth="80" />
                    <Button Grid.Column="1" Width="20" Height="14" Padding="0" MinWidth="0" MinHeight="0" Cursor="Hand"
                            VerticalAlignment="Center" Background="{Binding Brush}" BorderBrush="#3C000000" BorderThickness="1"
                            CornerRadius="0" Command="{Binding PickColorCommand}" ToolTip.Tip="Change series color" />
                    <TextBox Grid.Column="2" Text="{Binding Name}" ToolTip.Tip="Rename this stream's series" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </TabItem>
      <TabItem Header="Receiver SNR Streams">
        <DockPanel Margin="0,8,0,0">
          <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" ColumnSpacing="8">
            <TextBlock Text="Telemetry Stream Group:" VerticalAlignment="Center" />
            <ComboBox x:Name="SnrStream" Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding SnrStreams}"
                      SelectedItem="{Binding SelectedSnrStream}" IsEnabled="{Binding HasSnrStreams}" />
          </Grid>
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,8">
            <Button x:Name="SnrExpand" Content="{Binding ExpandText}" MinWidth="90" HorizontalContentAlignment="Center"
                    Command="{Binding ToggleExpandCommand}" IsEnabled="{Binding HasSnrStreams}" />
            <Button x:Name="SnrSelectAll" Content="Select All" Command="{Binding SelectAllSnrCommand}" />
            <Button x:Name="SnrSelectNone" Content="Select None" Command="{Binding SelectNoneSnrCommand}" />
          </StackPanel>
          <!-- The stream's receivers in two columns. -->
          <ScrollViewer>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
              <ItemsControl x:Name="LeftReceivers" Grid.Column="0" ItemsSource="{Binding SelectedSnrStream.LeftReceivers}"
                            ItemTemplate="{StaticResource ReceiverTemplate}" />
              <ItemsControl x:Name="RightReceivers" Grid.Column="1" ItemsSource="{Binding SelectedSnrStream.RightReceivers}"
                            ItemTemplate="{StaticResource ReceiverTemplate}" />
            </Grid>
          </ScrollViewer>
        </DockPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
