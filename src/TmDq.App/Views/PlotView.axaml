<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:TmDq.App.Views"
             xmlns:plot="using:TmDq.App.ViewModels.Plot"
             x:Class="TmDq.App.Views.PlotView">
  <UserControl.Styles>
    <!-- The chips: translucent, in the legend's visual language, so they read over the data. -->
    <Style Selector="Button.chip">
      <Setter Property="Height" Value="26" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource ChipBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ChipBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Foreground" Value="{DynamicResource ChipForeground}" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.chip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ChipBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ChipAccent}" />
      <Setter Property="Foreground" Value="{DynamicResource ChipForeground}" />
    </Style>
    <Style Selector="Button.chip:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ChipBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ChipAccent}" />
      <Setter Property="Foreground" Value="{DynamicResource ChipForeground}" />
    </Style>
  </UserControl.Styles>
  <!-- Everything here binds to the plot's commands (PlotCommands), which the view makes for its plot. -->
  <Grid x:Name="Root" x:FieldModifier="public" x:DataType="plot:PlotCommands">
    <!-- The plot's keys, which act only while the chart has focus (a bare letter taken application-wide would be lost to
         every text box): L the legend, V the metric, R both axes, Backspace one zoom back, Home the whole span (keeping a
         Y limit set), the arrows a tenth of the window, + and - the window about its centre (the keypad's too). Every one
         acts on data, so without any the key goes on unhandled. -->
    <Grid.KeyBindings>
      <KeyBinding Gesture="L" Command="{Binding ToggleLegendCommand}" />
      <KeyBinding Gesture="V" Command="{Binding ToggleViewModeCommand}" />
      <KeyBinding Gesture="R" Command="{Binding ResetViewCommand}" />
      <KeyBinding Gesture="Back" Command="{Binding ZoomBackCommand}" />
      <KeyBinding Gesture="Home" Command="{Binding ResetSpanCommand}" />
      <KeyBinding Gesture="Left" Command="{Binding PanEarlierCommand}" />
      <KeyBinding Gesture="Right" Command="{Binding PanLaterCommand}" />
      <KeyBinding Gesture="OemPlus" Command="{Binding ZoomInCommand}" />
      <KeyBinding Gesture="Shift+OemPlus" Command="{Binding ZoomInCommand}" />
      <KeyBinding Gesture="OemMinus" Command="{Binding ZoomOutCommand}" />
    </Grid.KeyBindings>
    <views:PlotChart x:Name="Chart" x:FieldModifier="public">
      <!-- The right-click menu, as v2.x had it: Set Plot Title first; Plot File; View Mode, its key in its title (a submenu
           can show no key of its own); Customize View; Show Legend; Readout; X Axis; Y Axes; Reset View. Everything that
           acts on data is disabled until there is some. Export is not here: it is a file operation, in the main menu (plan
           step 4.5). A key shown on an item is advertised only: the keys are the plot's (above). -->
      <views:PlotChart.ContextMenu>
        <ContextMenu x:Name="ChartMenu" x:FieldModifier="public">
          <MenuItem Header="Set Plot Title..." Command="{Binding SetTitleCommand}" />
          <Separator />
          <!-- Which processed file to view: every one overlaid, or one, with more than one, which batch runs bring (plan
               step 4.7, US1.1). -->
          <MenuItem x:Name="PlotFileMenu" x:FieldModifier="public" Header="Plot File" IsEnabled="{Binding CanChoosePlotFile}"
                    ItemsSource="{Binding PlotFiles}" ItemContainerTheme="{StaticResource RadioChoice}" />
          <MenuItem Header="View Mode  (V)" IsEnabled="{Binding CanSwitchViewMode}">
            <MenuItem Header="Lock Percentage" ToggleType="Radio" IsChecked="{Binding IsLockPercentView, Mode=OneWay}"
                      Command="{Binding ShowLockPercentCommand}" />
            <MenuItem Header="Accumulation" ToggleType="Radio" IsChecked="{Binding IsMissedFramesView, Mode=OneWay}"
                      Command="{Binding ShowMissedFramesCommand}" />
          </MenuItem>
          <Separator />
          <MenuItem Header="Customize View..." Command="{Binding CustomizeCommand}" />
          <MenuItem Header="Show Legend" ToggleType="CheckBox" IsChecked="{Binding LegendVisible, Mode=OneWay}"
                    InputGesture="L" Command="{Binding ToggleLegendCommand}" />
          <!-- The readout follows the nearest series unless pinned to one of those shown. -->
          <MenuItem x:Name="ReadoutMenu" x:FieldModifier="public" Header="Readout" IsEnabled="{Binding HasData}"
                    ItemsSource="{Binding ReadoutChoices}" ItemContainerTheme="{StaticResource RadioChoice}" />
          <Separator />
          <!-- Zoom Back above Reset Span: one level out, then every level at once. -->
          <MenuItem Header="X Axis" IsEnabled="{Binding HasData}">
            <MenuItem Header="Set Time Window..." Command="{Binding SetTimeWindowCommand}" />
            <MenuItem Header="Zoom Back" InputGesture="Back" Command="{Binding ZoomBackCommand}" />
            <MenuItem Header="Reset Span" InputGesture="Home" Command="{Binding ResetSpanCommand}" />
          </MenuItem>
          <!-- Each axis's two limits together, minimum first. -->
          <MenuItem Header="Y Axes" IsEnabled="{Binding HasData}">
            <MenuItem Header="Set Left Min..." Command="{Binding SetLeftMinCommand}" />
            <MenuItem Header="Set Left Max..." Command="{Binding SetLeftMaxCommand}" />
            <Separator />
            <MenuItem Header="Set Right Min..." Command="{Binding SetRightMinCommand}" />
            <MenuItem Header="Set Right Max..." Command="{Binding SetRightMaxCommand}" />
            <Separator />
            <MenuItem Header="Reset" Command="{Binding ResetYCommand}" />
          </MenuItem>
          <!-- Both axes at once: what the Reset view chip does, and R. -->
          <MenuItem Header="Reset View" InputGesture="R" Command="{Binding ResetViewCommand}" />
        </ContextMenu>
      </views:PlotChart.ContextMenu>
    </views:PlotChart>
    <!-- Over the chart, and only where its children are: the canvas has no background, so the rest reaches the chart. -->
    <Canvas x:Name="Overlay" x:FieldModifier="public">
      <!-- The View Mode chip only when there is another metric to switch to, named for the one it switches TO; the Reset
           chip only once the view differs from the default. With neither, the bar has no size. -->
      <StackPanel x:Name="ChipBar" x:FieldModifier="public" Orientation="Horizontal" Spacing="4" Canvas.Left="8" Canvas.Top="8"
                  IsVisible="{Binding HasData, FallbackValue=False}">
        <Button x:Name="ViewModeChip" x:FieldModifier="public" Classes="chip" IsVisible="{Binding CanSwitchViewMode, FallbackValue=False}"
                Content="{Binding ViewModeChipText}" ToolTip.Tip="{Binding ViewModeChipTip}" Command="{Binding ToggleViewModeCommand}" />
        <Button x:Name="ResetChip" x:FieldModifier="public" Classes="chip" Content="Reset view" IsVisible="{Binding CanResetView, FallbackValue=False}"
                ToolTip.Tip="Restore the full time span and automatic axis scaling (or double-click the chart)"
                Command="{Binding ResetViewCommand}" />
      </StackPanel>
      <views:PlotLegend x:Name="Legend" x:FieldModifier="public" />
    </Canvas>
    <!-- While a CSV is read for the plot (plan step 4.5); it takes no input. -->
    <Border x:Name="LoadingLabel" x:FieldModifier="public" IsVisible="{Binding IsLoading, FallbackValue=False}" IsHitTestVisible="False"
            HorizontalAlignment="Center" VerticalAlignment="Center" Padding="16,8" CornerRadius="6"
            Background="{DynamicResource LoadingBackground}" BorderBrush="{DynamicResource LoadingBorder}" BorderThickness="1">
      <TextBlock Text="Loading..." FontSize="16" Foreground="{DynamicResource LoadingForeground}" />
    </Border>
  </Grid>
</UserControl>
