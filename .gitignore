# NOTE: do NOT add a "*.gitignore" rule here — it would ignore every .gitignore
# (including this one), silently dropping the whole ignore policy from the repo.

# Build directories
samplefiles/

# Qt generated files
*.pro.user
*.pro.user.*
*.autosave
.qmake.stash
moc_*.cpp
moc_*.h
qrc_*.cpp
ui_*.h
*.qm
# generated by qmake from constants.h on every run
version_autogen.h

# Compiled Object files
*.o
*.obj
*.slo
*.lo
*.so
*.dylib
*.dll
*.a
*.lib
*.lai
*.la

# Executables
*.exe
*.out
*.app

# External libraries — tracked for reproducible builds

# IDE and editor settings
# .vscode: track the shared IDE setup, ignore per-machine/generated files.
# These were fully ignored until 2026-07-30, which is how launch.json kept a
# hard-coded Qt path through the 6.11.1 bump and broke F5 with 0xC0000135 - an
# untracked config never shows up in the diff that should have updated it.
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/c_cpp_properties.json
.vs/
*.creator.user*
*.suo
*.user

# clangd / clang-tidy IntelliSense DB — generated per-machine (absolute Qt/repo
# paths) by scripts/gen_compile_flags.py; never committed.
compile_flags.txt
compile_commands.json
*.ncb
*.sdf
*.opensdf
*.VC.opendb

# Deployment — see deploy/.gitignore for per-file rules

# AI tool settings — track shared config + project skills, ignore local/machine-specific files
.claude/*
!.claude/settings.json
!.claude/.claudeignore
!.claude/skills/

# Build artifacts
*.pdb
*.ilk
*.log
build/
debug/
release/
Makefile
Makefile.*

# Temporary files
*~
*.swp
*.bak
*.tmp

# OS generated files
.DS_Store
Thumbs.db
desktop.ini

# Test artifacts — see tests/.gitignore for per-file rules

# Settings TOML/INI files are tracked directly (no settings/.gitignore)

# Source artwork (only icon.ico is needed by the build)

# Input and Output files
*.csv
.clangd
status.txt
warnings.txt
# Local build/sign launcher — contains cert thumbprint, not for version control
build_and_sign.ps1

# Manual screenshots: the ORIGINALS in docs/manual_images/ are tracked so the
# manual can be regenerated, but the cropped/downscaled copies are derived output
# of scripts/build_manual.ps1.
docs/manual_images/processed/

# Python bytecode cache (scripts/ helpers)
__pycache__/
*.pyc
