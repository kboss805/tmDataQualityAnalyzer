# NOTE: do NOT add a "*.gitignore" rule here — it would ignore every .gitignore
# (including this one), silently dropping the whole ignore policy from the repo.

# Build directories
samplefiles/

# Qt generated files
*.pro.user
*.pro.user.*
*.autosave
.qmake.stash
moc_*.cpp
moc_*.h
qrc_*.cpp
ui_*.h
*.qm
# generated by qmake from constants.h on every run
version_autogen.h

# Compiled Object files
*.o
*.obj
*.slo
*.lo
*.so
*.dylib
*.dll
*.a
*.lib
*.lai
*.la

# Executables
*.exe
*.out
*.app

# External libraries — tracked for reproducible builds

# IDE and editor settings
.vscode/
.vs/
*.creator.user*
*.suo
*.user
*.ncb
*.sdf
*.opensdf
*.VC.opendb

# Deployment — see deploy/.gitignore for per-file rules

# AI tool settings — track shared config, ignore local/machine-specific files
.claude/*
!.claude/settings.json
!.claude/.claudeignore

# Build artifacts
*.pdb
*.ilk
*.log
build/
debug/
release/
Makefile
Makefile.*

# Temporary files
*~
*.swp
*.bak
*.tmp

# OS generated files
.DS_Store
Thumbs.db
desktop.ini

# Test artifacts — see tests/.gitignore for per-file rules

# Settings TOML/INI files are tracked directly (no settings/.gitignore)

# Source artwork (only icon.ico is needed by the build)

# Input and Output files
*.csv
.clangd
status.txt
warnings.txt
# Local build/sign launcher — contains cert thumbprint, not for version control
build_and_sign.ps1
