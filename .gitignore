# NOTE: do NOT add a "*.gitignore" rule here — it would ignore every .gitignore
# (including this one), silently dropping the whole ignore policy from the repo.

# Compiled Object files
*.o
*.obj
*.slo
*.lo
*.so
*.dylib
*.dll
*.a
*.lib
*.lai
*.la

# Executables
*.exe
*.out
*.app

# IDE and editor settings
# .vscode: track the shared IDE setup, ignore per-machine/generated files.
# These were fully ignored until 2026-07-30, which is how launch.json kept a
# hard-coded path through a toolkit bump and broke F5 with 0xC0000135 - an
# untracked config never shows up in the diff that should have updated it.
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/c_cpp_properties.json
.vs/
*.suo
*.user

# clangd / clang-tidy IntelliSense DB — generated per-machine (absolute repo
# paths) by eng/gen_compile_flags.py; never committed.
compile_flags.txt
compile_commands.json

*.sdf
*.opensdf
*.VC.opendb

# Deployment — see deploy/.gitignore for per-file rules

# AI tool settings — track shared config + project skills, ignore local/machine-specific files
.claude/*
!.claude/settings.json
!.claude/.claudeignore
!.claude/skills/
!.claude/CLAUDE.md

# Build artifacts
*.pdb
*.ilk
*.log

# .NET build output, in every project folder under src/ and tests/.
bin/
obj/
# "*.app" above (a macOS app bundle) also matches src/TmDq.App/, because git on Windows ignores case. Without this line
# git status does not even list the folder, and a commit silently leaves it out.
!TmDq.App/

# Temporary files
*~
*.swp
*.bak
*.tmp

# OS generated files
.DS_Store
Thumbs.db
desktop.ini

# Test artifacts — see tests/.gitignore for per-file rules

# Settings TOML/INI files are tracked directly (no settings/.gitignore)

# Input and Output files
*.csv
.clangd

# Manual figures: the RENDERED ones in docs/manual_images/ are tracked so the
# manual can be regenerated, but the downscaled copies are derived output of
# eng/build_manual.ps1.
docs/manual_images/processed/

# Python bytecode cache (eng/ helpers)
__pycache__/
*.pyc

# The native projects' build output (src/core/tmdq_core.vcxproj and tests/core/tmdq_core_tests.vcxproj): the DLL,
# the test exe and the build logs in out/<config>/ and out/, the objects in out/obj/.
/out/
