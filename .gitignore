# NOTE: do NOT add a "*.gitignore" rule here — it would ignore every .gitignore
# (including this one), silently dropping the whole ignore policy from the repo.

# Build directories
samplefiles/

# What the Qt build (deleted in plan step 6.1) generated, still ignored so a checkout that built it before does
# not show its leftovers: build/, tests/debug, tests/release, the Makefiles, version_autogen.h and the generated
# Visual Studio solution below. They are safe to delete.
.qmake.stash
version_autogen.h

# Compiled Object files
*.o
*.obj
*.slo
*.lo
*.so
*.dylib
*.dll
*.a
*.lib
*.lai
*.la

# Executables
*.exe
*.out
*.app

# External libraries — tracked for reproducible builds

# IDE and editor settings
# .vscode: track the shared IDE setup, ignore per-machine/generated files.
# These were fully ignored until 2026-07-30, which is how launch.json kept a
# hard-coded path through a toolkit bump and broke F5 with 0xC0000135 - an
# untracked config never shows up in the diff that should have updated it.
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/c_cpp_properties.json
.vs/
*.creator.user*
*.suo
*.user

# clangd / clang-tidy IntelliSense DB — generated per-machine (absolute repo
# paths) by scripts/gen_compile_flags.py; never committed.
compile_flags.txt
compile_commands.json

# The Visual Studio solution the deleted scripts/gen_vs_project.ps1 generated from the .pro files (tmdq.sln is the
# committed one); the unrelated per-user .vs/ cache VS itself creates is ignored above.
/vs/
/tmDataQualityAnalyzer.sln
*.ncb
*.sdf
*.opensdf
*.VC.opendb

# Deployment — see deploy/.gitignore for per-file rules

# AI tool settings — track shared config + project skills, ignore local/machine-specific files
.claude/*
!.claude/settings.json
!.claude/.claudeignore
!.claude/skills/
!.claude/CLAUDE.md

# Build artifacts
*.pdb
*.ilk
*.log
build/
debug/
release/
Makefile
Makefile.*

# Temporary files
*~
*.swp
*.bak
*.tmp

# OS generated files
.DS_Store
Thumbs.db
desktop.ini

# Test artifacts — see tests/.gitignore for per-file rules

# Settings TOML/INI files are tracked directly (no settings/.gitignore)

# Source artwork (only icon.ico is needed by the build)

# Input and Output files
*.csv
.clangd
status.txt
warnings.txt
# Local build/sign launcher — contains cert thumbprint, not for version control
build_and_sign.ps1

# Manual figures: the RENDERED ones in docs/manual_images/ are tracked so the
# manual can be regenerated, but the downscaled copies are derived output of
# scripts/build_manual.ps1.
docs/manual_images/processed/

# Python bytecode cache (scripts/ helpers)
__pycache__/
*.pyc

# The native core project (native/): build output
/native/out/
/native/obj/
