<Project>

  <!--
    Plan decision D5: every NuGet package a project resolves, transitive ones included, must carry an open-source
    licence on the allow-list in scripts\check_package_licences.ps1, so a proprietary component (an Avalonia
    Accelerate package, say) cannot arrive through a NuGet suggestion. A package outside it fails the build.

    It runs after the package assets are resolved, and again only when the assets file changes (the stamp file).
  -->

  <PropertyGroup>
    <TmDqLicenceScript>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)..\..\scripts\check_package_licences.ps1'))</TmDqLicenceScript>
  </PropertyGroup>

  <!-- The stamp's path is written in the target, not in a property above: a project imports this file before the
       SDK's targets set IntermediateOutputPath, so a property would see it empty and put the stamp in the project
       folder. A target's attributes are expanded when it runs, with the final values. -->
  <Target Name="TmDqCheckPackageLicences"
          AfterTargets="ResolvePackageAssets"
          Condition="Exists('$(ProjectAssetsFile)')"
          Inputs="$(ProjectAssetsFile);$(TmDqLicenceScript)"
          Outputs="$(IntermediateOutputPath)package-licences.ok">
    <!-- High importance, so the line saying how many packages were checked shows at the default verbosity too. -->
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(TmDqLicenceScript)&quot; -AssetsFile &quot;$(ProjectAssetsFile)&quot;"
          StandardOutputImportance="high" />
    <Touch Files="$(IntermediateOutputPath)package-licences.ok" AlwaysCreate="true" />
  </Target>

</Project>
