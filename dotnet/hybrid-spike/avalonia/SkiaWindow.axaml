<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Tmdq.AvaloniaSpike"
        x:Class="Tmdq.AvaloniaSpike.SkiaWindow"
        Title="Avalonia chart spike (Skia)" Width="1260" Height="800" Background="#FF202020"
        WindowStartupLocation="CenterScreen">
  <!-- MainWindow.axaml with the chart drawn by Skia instead of imported from Direct2D. -->
  <DockPanel>
    <TextBlock x:Name="Status" DockPanel.Dock="Bottom" Foreground="White" Margin="8,4" FontFamily="Consolas"
               Text="starting..."/>
    <Grid x:Name="Stage" Width="1200" Height="700" HorizontalAlignment="Center" VerticalAlignment="Center">
      <local:SkiaChart x:Name="Chart" Width="1200" Height="700" HorizontalAlignment="Left" VerticalAlignment="Top"/>

      <Border x:Name="Legend" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,24,24,0"
              Background="#E6101828" CornerRadius="6" Padding="10,8" BorderBrush="#FF6C63E6" BorderThickness="1">
        <StackPanel>
          <TextBlock Text="Receiver SNR" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,4"/>
          <StackPanel Orientation="Horizontal">
            <Rectangle Width="14" Height="3" Fill="#FF6C63E6" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBlock Text="Ch 13 L" Foreground="White"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal">
            <Rectangle Width="14" Height="3" Fill="#FF2E9E6B" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBlock Text="Ch 13 R" Foreground="White"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
