<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Drives tmdq_core.dll - built with NO Qt by native\build_core.ps1 - from managed code.

    TmdqCore.cs is the interop spike's P/Invoke layer, linked in unchanged: the ABI header is the
    same, so the same managed binding must keep working against the Qt-free implementation. That is
    half the point of this project.

    -p:Utf8Manifest=true merges an app manifest selecting the UTF-8 active code page into the exe
    (target below). Without it a non-ASCII path cannot reach the vendored irig106 library, which is
    a difference between this host and the Qt application, whose exe embeds the same setting.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>HybridDriver</AssemblyName>
    <RootNamespace>Tmdq.HybridSpike</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!--
    The SDK's ApplicationManifest property embeds the manifest in the managed assembly, NOT in the
    apphost exe that is the actual process - verified: the exe carries no manifest and the active
    code page stays 1252. So the manifest is merged into the exe after the build with mt.exe
    (Windows SDK; on PATH after scripts\env.ps1). Run the exe itself, not `dotnet run`: that starts
    dotnet.exe, whose own manifest wins.
  -->
  <Target Name="EmbedUtf8Manifest" AfterTargets="Build" Condition="'$(Utf8Manifest)' == 'true'">
    <Exec Command="mt -nologo -manifest &quot;$(MSBuildProjectDirectory)\app.manifest&quot; -outputresource:&quot;$(OutDir)$(AssemblyName).exe;#1&quot;" />
  </Target>

  <ItemGroup>
    <Compile Include="..\..\interop-spike\TmdqCore.cs" Link="TmdqCore.cs" />
  </ItemGroup>

</Project>
