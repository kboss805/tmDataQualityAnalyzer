<Window x:Class="Tmdq.WpfSpike.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="D3DImage chart spike" Width="1260" Height="800" Background="#FF202020"
        WindowStartupLocation="CenterScreen">
  <DockPanel>
    <TextBlock x:Name="Status" DockPanel.Dock="Bottom" Foreground="White" Margin="8,4" FontFamily="Consolas"
               Text="starting..."/>

    <!-- The chart is an Image whose Source is a D3DImage. Everything inside this Grid that comes
         after it is drawn ON TOP of the chart, by WPF, with no special handling. -->
    <Grid x:Name="Stage" Width="1200" Height="700" HorizontalAlignment="Center" VerticalAlignment="Center">
      <Image x:Name="Chart" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top"/>

      <Border x:Name="Legend" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,24,24,0"
              Background="#E6101828" CornerRadius="6" Padding="10,8" BorderBrush="#FF6C63E6" BorderThickness="1">
        <StackPanel>
          <TextBlock Text="Receiver SNR" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,4"/>
          <StackPanel Orientation="Horizontal">
            <Rectangle x:Name="Swatch" Width="14" Height="3" Fill="#FF6C63E6" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBlock Text="Ch 13 L" Foreground="White"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal">
            <Rectangle Width="14" Height="3" Fill="#FF2E9E6B" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBlock Text="Ch 13 R" Foreground="White"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <Line x:Name="Crosshair" Stroke="#99FFFFFF" StrokeThickness="1" Y1="0" Y2="700" Visibility="Collapsed"/>
      <TextBlock x:Name="Readout" Foreground="White" Background="#CC000000" Padding="4,2" Visibility="Collapsed"
                 HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="Consolas"/>
    </Grid>
  </DockPanel>
</Window>
