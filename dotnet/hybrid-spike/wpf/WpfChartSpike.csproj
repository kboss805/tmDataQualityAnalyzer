<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Hosts the native Direct2D chart (native\out\tmdq_chart.dll) in WPF through D3DImage and puts
    ordinary WPF elements - a legend, a crosshair readout - OVER it. That overlay is the point: it
    is the "airspace" problem the presentation-layer assessment flagged, and D3DImage is the answer
    to it, because the chart is an image WPF composes rather than a child window WPF cannot draw on.

    Build native\build_chart.ps1 first. The DLL is copied beside the exe.
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>WpfChartSpike</AssemblyName>
    <RootNamespace>Tmdq.WpfSpike</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\native\out\tmdq_chart.dll" Link="tmdq_chart.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
