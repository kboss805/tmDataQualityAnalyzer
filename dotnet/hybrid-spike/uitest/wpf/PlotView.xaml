<UserControl x:Class="Tmdq.UiSpike.Wpf.PlotView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="900" Height="560">
  <!-- The same tree as avalonia/PlotView.axaml. -->
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="Vis"/>
    <!-- Paint only; size lives on the element (see the Avalonia twin). -->
    <Style x:Key="TitleButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
  </UserControl.Resources>
  <DockPanel Background="#FF202020">
    <DockPanel x:Name="TitleBar" DockPanel.Dock="Top" Height="32" Background="#FF2B2B2B">
      <Button x:Name="CloseButton" Style="{StaticResource TitleButton}" DockPanel.Dock="Right" Content="X"
              Width="30" Height="26" Margin="0,3,3,3" Padding="0"
              HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
      <TextBlock Text="Plot" Foreground="White" VerticalAlignment="Center" Margin="10,0"/>
    </DockPanel>
    <Grid>
      <Border x:Name="Plot" Background="White" Focusable="True"/>
      <Border x:Name="Legend" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,12,0"
              Background="#E6101828" CornerRadius="6" Padding="10,8" BorderBrush="#FF6C63E6" BorderThickness="1"
              Visibility="{Binding LegendVisible, Converter={StaticResource Vis}}" IsHitTestVisible="False">
        <ScrollViewer x:Name="LegendScroll" MaxHeight="120" VerticalScrollBarVisibility="Auto">
          <ItemsControl x:Name="LegendRows" ItemsSource="{Binding Series}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" Margin="0,1">
                  <Rectangle Width="14" Height="3" Fill="#FF6C63E6" VerticalAlignment="Center" Margin="0,0,6,0"/>
                  <TextBlock Text="{Binding}" Foreground="White" FontSize="13"/>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Border>
    </Grid>
  </DockPanel>
</UserControl>
