<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The plot's measured-widget tests on Avalonia's headless platform (no window system, no GPU).
    An xunit v3 test project is an executable: run bin\Release\net10.0\AvaloniaUiTests.exe directly.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AssemblyName>AvaloniaUiTests</AssemblyName>
    <RootNamespace>Tmdq.UiSpike.Ava</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.4" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\common\PlotVm.cs" Link="PlotVm.cs" />
  </ItemGroup>

</Project>
