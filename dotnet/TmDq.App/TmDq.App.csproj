<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The Avalonia application that replaces the Qt one (docs/dotnet-migration/avalonia-plan.md, step 3).
    MVVM with CommunityToolkit.Mvvm; the processing core is tmdq_core.dll, reached through TmDq.Core.
    Until the switch-over (plan step 6.1) the Qt application is the one that ships.

    - The version comes from AppVersion in include/constants.h (..\build\AppVersion.props); never type one here.
    - Every package must be on the open-source licence allow-list (..\build\PackageLicences.targets, plan D5):
      no Avalonia Accelerate component, whatever an IDE suggests.
    - The exe carries a manifest selecting the UTF-8 active code page (app.manifest), because the vendored
      irig106 library opens recordings with the C runtime's NARROW open(), which reads that code page. The SDK's
      ApplicationManifest property embeds a manifest in the managed assembly, NOT in the apphost exe that is
      the process (found in the spike, dotnet/hybrid-spike/README.md), so mt.exe (the Windows SDK; on PATH after
      scripts\env.ps1) merges it into every host the SDK creates, which reaches both the build output and a
      single-file publish (the targets below). Run the exe, not `dotnet run`, whose process is dotnet.exe with its
      own manifest.
  -->

  <Import Project="..\build\AppVersion.props" />

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>tmDataQualityAnalyzer</AssemblyName>
    <RootNamespace>TmDq.App</RootNamespace>
    <Product>TM Data Quality Analyzer</Product>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <AppendPlatformToOutputPath>false</AppendPlatformToOutputPath>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TmDq.Core\TmDq.Core.csproj" />
  </ItemGroup>

  <!-- The native core, from the native build of the same configuration (scripts\build_core_dll.ps1), beside the exe in
       the build output, in what references this project (the tests), and in a publish. Kept OUT of a single-file
       bundle: a native library has to be a file on disk to load. The VC++ runtime it imports is added by the packaging
       script (deploy\avalonia\build_avalonia_package.ps1). Missing, the app says so when it first needs the core. -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\..\native\out\$(Configuration)\tmdq_core.dll"
          Condition="Exists('$(MSBuildThisFileDirectory)..\..\native\out\$(Configuration)\tmdq_core.dll')"
          Link="tmdq_core.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true" Visible="false" />
  </ItemGroup>

  <!-- The manifest goes into each intermediate host the SDK creates, before anything copies or bundles it: apphost
       for a build (copied to bin\), singlefilehost for a self-contained single-file publish, apphost_publish for
       other publishes. Patching the exe in bin\ after the build (as the test projects do) misses the published app:
       a single-file publish bundles its own host from obj\, and shipped with the SDK's default manifest, no UTF-8 code
       page and no Windows 10 compatibility (found in plan step 3.3). One target per host, because a target runs at
       most once per build and the hosts are created at different points of it. -->
  <Target Name="TmDqManifestIntoAppHost" AfterTargets="_CreateAppHost" Condition="Exists('$(AppHostIntermediatePath)')">
    <Exec Command="mt -nologo -manifest &quot;$(MSBuildProjectDirectory)\app.manifest&quot; -outputresource:&quot;$(AppHostIntermediatePath);#1&quot;" />
  </Target>
  <Target Name="TmDqManifestIntoSingleFileHost" AfterTargets="_CreateSingleFileHost" Condition="Exists('$(SingleFileHostIntermediatePath)')">
    <Exec Command="mt -nologo -manifest &quot;$(MSBuildProjectDirectory)\app.manifest&quot; -outputresource:&quot;$(SingleFileHostIntermediatePath);#1&quot;" />
  </Target>
  <Target Name="TmDqManifestIntoPublishHost" AfterTargets="_CreateAppHostForPublish" Condition="Exists('$(AppHostForPublishIntermediatePath)')">
    <Exec Command="mt -nologo -manifest &quot;$(MSBuildProjectDirectory)\app.manifest&quot; -outputresource:&quot;$(AppHostForPublishIntermediatePath);#1&quot;" />
  </Target>

  <Import Project="..\build\PackageLicences.targets" />

</Project>
