<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <!-- Merged into tmDataQualityAnalyzer.exe after the build by mt.exe (see TmDq.App.csproj), replacing the
       apphost's own manifest, so everything the process needs from a manifest is here. -->
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and 11: without it the version APIs report Windows 8. -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>
  <!-- Selects the UTF-8 active code page for this process (Windows 10 1903+). The vendored irig106 library
       opens files with the C runtime's NARROW open(), which reads that code page; with this set, a UTF-8 path
       from managed code reaches it intact. The Qt application embeds the same setting
       (resources/utf8codepage.manifest). -->
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
