<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TmDq.App.ViewModels"
        xmlns:views="using:TmDq.App.Views"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        x:Class="TmDq.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Width="1280" Height="800"
        MinWidth="640" MinHeight="400"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="BorderOnly"
        ExtendClientAreaTitleBarHeightHint="40"
        DragDrop.AllowDrop="True">
  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenCommand}" />
    <KeyBinding Gesture="Ctrl+B" Command="{Binding ToggleSidebarCommand}" />
  </Window.KeyBindings>
  <Window.Styles>
    <!-- The title bar's buttons: borderless glyphs with a soft hover, as the Qt title bar draws them. -->
    <Style Selector="Grid#TitleBar Button">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="26" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Grid#TitleBar Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource TitleBarHover}" />
    </Style>
    <Style Selector="Grid#TitleBar Button.caption">
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
      <Setter Property="FontSize" Value="10" />
    </Style>
    <Style Selector="Grid#TitleBar Button.glyph">
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
      <Setter Property="FontSize" Value="15" />
    </Style>
    <Style Selector="Grid#TitleBar Button#CloseButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#C42B1C" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <!-- The sidebar toggle is a glyph like the others, shown or not, never the theme's filled "checked" button. -->
    <Style Selector="Grid#TitleBar ToggleButton:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource ToggleButtonForeground}" />
    </Style>
    <Style Selector="Grid#TitleBar ToggleButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource TitleBarHover}" />
      <Setter Property="Foreground" Value="{DynamicResource ToggleButtonForeground}" />
    </Style>
  </Window.Styles>
  <DockPanel>
    <!-- The title bar (plan step 4.8), where the system's was: the menu and the sidebar toggle on the left, the window's
         buttons on the right, and between them the caption that drags, snaps and maximizes on a double-click. Each part
         tells Windows what it is (its element role): the maximize button as the maximize button, which is what makes
         Windows 11 offer its snap layouts on a hover. -->
    <Grid x:Name="TitleBar" x:FieldModifier="public" DockPanel.Dock="Top" Height="40" ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto"
          Margin="2,0,6,0">
      <Button x:Name="MenuButton" x:FieldModifier="public" Grid.Column="0" Classes="glyph" Content="&#xE700;" ToolTip.Tip="Menu"
              chrome:WindowDecorationProperties.ElementRole="User" />
      <ToggleButton x:Name="SidebarButton" x:FieldModifier="public" Grid.Column="1" Width="30" Height="26" Padding="0"
                    VerticalAlignment="Center" Background="Transparent" BorderThickness="0" CornerRadius="5"
                    FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" Content="&#xE89F;"
                    IsChecked="{Binding SidebarVisible}" ToolTip.Tip="Toggle sidebar (Ctrl+B)"
                    chrome:WindowDecorationProperties.ElementRole="User" />
      <Border x:Name="Caption" x:FieldModifier="public" Grid.Column="2" Background="Transparent"
              chrome:WindowDecorationProperties.ElementRole="TitleBar" />
      <Button x:Name="MinimizeButton" x:FieldModifier="public" Grid.Column="3" Classes="caption" Content="&#xE921;" ToolTip.Tip="Minimize"
              Click="OnMinimize" chrome:WindowDecorationProperties.ElementRole="MinimizeButton" />
      <Button x:Name="MaximizeButton" x:FieldModifier="public" Grid.Column="4" Classes="caption" Content="&#xE922;" ToolTip.Tip="Maximize"
              Click="OnMaximize" chrome:WindowDecorationProperties.ElementRole="MaximizeButton" />
      <Button x:Name="CloseButton" x:FieldModifier="public" Grid.Column="5" Classes="caption" Content="&#xE8BB;" ToolTip.Tip="Close"
              Click="OnClose" chrome:WindowDecorationProperties.ElementRole="CloseButton" />
    </Grid>
    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="8,4">
      <TextBlock x:Name="StatusText" Grid.Column="0" Text="{Binding Status}" TextTrimming="CharacterEllipsis"
                 VerticalAlignment="Center" />
      <TextBlock x:Name="VersionLabel" Grid.Column="1" Text="{Binding VersionText}" Margin="16,0,0,0"
                 VerticalAlignment="Center" />
    </Grid>
    <!-- The log sidebar on the left (the Qt dock's place and minimum width), the chart beside it; the toggle in the
         title bar hides it. Progress is in the modal progress dialog while a run goes on, as in Qt. -->
    <Grid x:Name="Body" x:FieldModifier="public" ColumnDefinitions="400,4,*">
      <Border x:Name="LogPanel" Grid.Column="0" MinWidth="400" Margin="2,4,0,4" BorderThickness="1" CornerRadius="4"
              BorderBrush="{DynamicResource LogPanelBorder}" Background="{DynamicResource LogPanelBackground}"
              IsVisible="{Binding SidebarVisible}">
        <views:LogView x:Name="Log" Entries="{Binding Log.Entries}" />
      </Border>
      <GridSplitter x:Name="Splitter" Grid.Column="1" ResizeDirection="Columns" Background="Transparent"
                    IsVisible="{Binding SidebarVisible}" />
      <views:PlotView x:Name="PlotView" Grid.Column="2" Plot="{Binding Plot}" />
    </Grid>
  </DockPanel>
</Window>
