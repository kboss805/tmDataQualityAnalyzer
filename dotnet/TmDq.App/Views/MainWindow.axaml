<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TmDq.App.ViewModels"
        xmlns:views="using:TmDq.App.Views"
        x:Class="TmDq.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Width="1280" Height="800"
        MinWidth="640" MinHeight="400">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="8">
      <Button x:Name="OpenButton" Content="Open..." Command="{Binding OpenCommand}" />
      <!-- The Qt menu's Import/Export section, here until the shell's menu (plan step 4.8). -->
      <Button x:Name="ImportCsvButton" Content="Import CSV..." Command="{Binding ImportCsvCommand}"
              ToolTip.Tip="Import a previously exported CSV file" />
      <Button x:Name="ExportButton" Content="Export..." Command="{Binding ExportCommand}"
              ToolTip.Tip="Export plot data and images" />
    </StackPanel>
    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="8,4">
      <TextBlock x:Name="StatusText" Grid.Column="0" Text="{Binding Status}" TextTrimming="CharacterEllipsis"
                 VerticalAlignment="Center" />
      <TextBlock x:Name="VersionLabel" Grid.Column="1" Text="{Binding VersionText}" Margin="16,0,0,0"
                 VerticalAlignment="Center" />
    </Grid>
    <!-- The log sidebar on the left (the Qt dock's place and minimum width), the chart beside it. Progress is in the
         modal progress dialog while a run goes on, as in Qt. -->
    <Grid ColumnDefinitions="400,4,*">
      <Border x:Name="LogPanel" Grid.Column="0" MinWidth="400" Margin="2,4,0,4" BorderThickness="1" CornerRadius="4"
              BorderBrush="#E5E5E5" Background="#FFFFFF">
        <views:LogView x:Name="Log" Entries="{Binding Log.Entries}" />
      </Border>
      <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="Transparent" />
      <views:PlotView x:Name="PlotView" Grid.Column="2" Plot="{Binding Plot}" />
    </Grid>
  </DockPanel>
</Window>
