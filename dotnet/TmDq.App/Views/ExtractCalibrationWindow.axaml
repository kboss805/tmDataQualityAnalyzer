<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TmDq.App.ViewModels"
        x:Class="TmDq.App.Views.ExtractCalibrationWindow"
        x:DataType="vm:ExtractCalibrationViewModel"
        Title="{x:Static vm:ExtractCalibrationViewModel.Title}"
        SizeToContent="WidthAndHeight"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <!-- As the Qt dialog: the step file, the calibration recording, each with its status beneath, then the clips. -->
  <StackPanel Margin="16" Spacing="8">
    <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,12,Auto,Auto,16,Auto,Auto" ColumnSpacing="12" RowSpacing="4">
      <TextBlock Grid.Row="0" Grid.Column="0" Text="Step Cal File:" VerticalAlignment="Center" />
      <TextBlock x:Name="StepName" Grid.Row="0" Grid.Column="1" Text="{Binding StepName}" MinWidth="260" VerticalAlignment="Center" />
      <Button x:Name="BrowseStep" Grid.Row="0" Grid.Column="2" Content="Browse..." Command="{Binding BrowseStepCommand}"
              ToolTip.Tip="Browse for the step calibration configuration TOML file that defines the RF signal step levels." />
      <TextBlock x:Name="StepStatus" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding StepStatus}"
                 Foreground="{Binding StepBrush}" TextWrapping="Wrap" MaxWidth="420" />

      <TextBlock Grid.Row="3" Grid.Column="0" Text="Calibration Ch10:" VerticalAlignment="Center" />
      <TextBlock x:Name="CalName" Grid.Row="3" Grid.Column="1" Text="{Binding CalName}" MinWidth="260" VerticalAlignment="Center" />
      <Button x:Name="BrowseCal" Grid.Row="3" Grid.Column="2" Content="Browse..." Command="{Binding BrowseCalCommand}"
              ToolTip.Tip="Browse for the calibration Chapter 10 recording file. The last folder you used will be remembered." />
      <TextBlock x:Name="CalStatus" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding CalStatus}"
                 Foreground="{Binding CalBrush}" TextWrapping="Wrap" MaxWidth="420" />

      <TextBlock Grid.Row="6" Grid.Column="0" Text="Clip Start (s):" VerticalAlignment="Center" />
      <NumericUpDown x:Name="ClipStart" Grid.Row="6" Grid.Column="1" Width="150" HorizontalAlignment="Left"
                     Value="{Binding ClipStart}" Minimum="0" Maximum="100000" Increment="1" FormatString="0.0"
                     ToolTip.Tip="Ignore this many seconds at the START of the calibration recording before detecting steps (skips signal-generator turn-on transients)." />
      <TextBlock Grid.Row="7" Grid.Column="0" Text="Clip End (s):" VerticalAlignment="Center" />
      <NumericUpDown x:Name="ClipEnd" Grid.Row="7" Grid.Column="1" Width="150" HorizontalAlignment="Left"
                     Value="{Binding ClipEnd}" Minimum="0" Maximum="100000" Increment="1" FormatString="0.0"
                     ToolTip.Tip="Ignore this many seconds at the END of the calibration recording before detecting steps." />
    </Grid>

    <Separator Margin="0,8" />
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button x:Name="OkButton" Classes="accent" Content="OK" MinWidth="80" IsDefault="True" Command="{Binding OkCommand}" />
      <Button x:Name="CancelButton" Content="Cancel" MinWidth="80" IsCancel="True" Command="{Binding CancelCommand}" />
    </StackPanel>
  </StackPanel>
</Window>
