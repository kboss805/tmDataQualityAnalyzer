<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <WindowsPackageType>None</WindowsPackageType>
    <AssemblyName>Win2DProbe</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Probe.cs" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.4.0" />
    <!-- DIRECT reference, not just the transitive one Win2D brings. With
         WindowsPackageType=None these targets inject the bootstrapper that
         initializes the Windows App Runtime for an UNPACKAGED app; without it the
         process exits silently before Main (observed: exit 22, no output), even
         though runtime 1.6 was installed the whole time. -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
  </ItemGroup>
</Project>
