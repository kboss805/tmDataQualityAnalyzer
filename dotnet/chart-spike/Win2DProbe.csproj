<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <WindowsPackageType>None</WindowsPackageType>
    <AssemblyName>Win2DProbe</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- Skip the Windows App SDK PRI generation, which needs Visual Studio's
         AppxPackage MSBuild tooling (Microsoft.Build.Packaging.Pri.Tasks.dll).
         Only VS BuildTools is installed here, without that workload. The targets
         gate the task on this property, and an offscreen console app has no MRT
         resources to index anyway. -->
    <AppxGeneratePriEnabled>false</AppxGeneratePriEnabled>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Probe.cs" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.3.2" />
  </ItemGroup>
</Project>
